.anni-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.login-title {
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.login-btn {
  width: 300rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-warm));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.anni-content {
  padding: 20rpx 24rpx;
}

.anni-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.anni-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
}

.countdown-section {
  display: flex;
  justify-content: center;
  padding: 30rpx 0 20rpx;
}

.countdown-bg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(255, 107, 157, 0.3);
}

.countdown-number {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 500;
}

.countdown-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.anni-info {
  padding: 0 30rpx 20rpx;
  text-align: center;
}

.anni-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.anni-type-icon {
  font-size: 32rpx;
}

.anni-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.anni-type {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}

.anni-date {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.anni-hint {
  font-size: 22rpx;
  color: var(--color-primary);
  display: block;
}

.anni-hint.today {
  color: var(--color-pink-deep);
  font-weight: 500;
  font-size: 26rpx;
}

.anni-hint.past {
  color: #999999;
}

.anni-actions {
  display: flex;
  border-top: 1rpx solid var(--border-light);
}

.anni-action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  position: relative;
}

.anni-action-btn:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 25%;
  width: 1rpx;
  height: 50%;
  background-color: var(--border-light);
}

.action-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666666;
}

.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.add-btn-container {
  padding: 20rpx 0 60rpx;
  display: flex;
  justify-content: center;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-warm));
  color: #ffffff;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 4px 20px rgba(255, 107, 157, 0.3);
}

.add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
  font-weight: 500;
}

.add-text {
  font-size: 28rpx;
  font-weight: 500;
}

.form-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.form-modal {
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding-bottom: env(safe-area-inset-bottom);
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.form-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.form-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-secondary);
  border-radius: 50%;
}

.close-icon {
  font-size: 28rpx;
  color: #999999;
}

.form-body {
  padding: 20rpx 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid var(--border-light);
}

.form-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  align-items: center;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-light);
}

.picker-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.picker-text {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
}

.reminder-options {
  display: flex;
  gap: 16rpx;
}

.reminder-option {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background-color: var(--bg-color);
  border: 2rpx solid var(--border-light);
}

.reminder-option.active {
  background-color: #fff5f7;
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.option-text {
  font-size: 24rpx;
}

.form-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.form-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.form-btn.cancel {
  background-color: var(--bg-secondary);
  color: #666666;
}

.form-btn.save {
  background: linear-gradient(135deg, var(--color-primary), var(--color-warm));
  color: #ffffff;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
