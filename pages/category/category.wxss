}

.font-extra-large .current-price {
  font-size: 42rpx;
}

.font-extra-large .add-to-cart-btn {
  font-size: 30rpx;
  padding: 16rpx 34rpx;
}

.font-extra-large .filter-tab {
  font-size: 36rpx;
}

.font-extra-large .panel-title {
  font-size: 42rpx;
}

.font-extra-large .tab-item {
  font-size: 34rpx;
  padding: 18rpx 40rpx;
}

/* ===== 排序面板选项样式 ===== */
