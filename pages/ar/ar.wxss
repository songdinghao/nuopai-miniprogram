.ar-page {
  background-color: #000000;
  min-height: 100vh;
}

.page-container {
  font-family: -apple-system, BlinkMacSystemFont,
               "PingFang SC", "Hiragino Sans GB",
               "Microsoft YaHei", "Helvetica Neue",
               Helvetica, Arial, sans-serif;
}

.nav-bar {
  height: 88px;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 12px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-back {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20px;
}

.back-icon {
  width: 24px;
  height: 24px;
  filter: invert(1);
}

.nav-title {
  flex: 1;
  text-align: center;
}

.title-text {
  font-size: 18px;
  font-weight: 500;
  color: #ffffff;
}

.nav-help {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20px;
}

.help-icon {
  font-size: 20px;
  font-weight: 600;
  color: #ffffff;
}

.page-content {
  position: relative;
  height: 100vh;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #000000;
}

.loading-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid rgba(255, 255, 255, 0.2);
  border-top: 4px solid var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20px;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 16px;
  color: #ffffff;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #000000;
  padding: 32px;
}

.error-icon {
  width: 100px;
  height: 100px;
  margin-bottom: 24px;
  opacity: 0.6;
}

.error-title {
  font-size: 20px;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 12px;
  text-align: center;
}

.error-desc {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32px;
  text-align: center;
  line-height: 1.6;
}

.error-actions {
  display: flex;
  gap: 16px;
}

.btn-secondary {
  padding: 12px 28px;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 500;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn-primary {
  padding: 12px 28px;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 500;
  color: #ffffff;
  background-color: var(--color-primary);
  border: none;
}

.ar-container {
  position: relative;
  height: 100vh;
}

.ar-camera {
  width: 100%;
  height: 100%;
}

.ar-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 24px 32px;
  border-radius: 16px;
  z-index: 50;
}

.hint-icon {
  width: 60px;
  height: 60px;
  margin-bottom: 16px;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.5;
  }
}

.hint-text {
  font-size: 16px;
  color: #666666;
  text-align: center;
}

.ar-product {
  position: absolute;
  top: 0;
  left: 0;
  transform: translate(-50%, -50%);
  z-index: 200;
}

.ar-product-image {
  width: 200px;
  height: 36px;
  border-radius: 12px;
}

.ar-product-shadow {
  width: 180px;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.4) 0%, transparent 70%);
  margin-top: auto;
}

.ar-controls {
  position: fixed;
  bottom: 0;
  right: 0;
}

.product-selector {
  background-color: rgba(0, 0, 0, 0.6);
  padding: 24px;
}

.product-list {
  display: flex;
  gap: 20px;
}

.product-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.9);
  border: none;
  min-width: 70px;
}

.product-item.selected {
  background-color: rgba(255, 107, 157, 0.3);
  border-color: var(--color-primary);
}

.product-thumb {
  width: 60px;
  margin-bottom: 24px;
}

.product-name {
  font-size: 12px;
  line-height: 1.6;
  display: flex;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  max-width: 360px;
}

.control-buttons {
  display: flex;
  justify-content: center;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
}

.control-btn {
  display: flex;
}

.place-btn, .photo-btn {
  background-color: var(--color-primary);
}

.btn-icon {
  width: 28px;
  filter: invert(1);
}

.btn-text {
  font-size: 13px;
}

.product-info-card {
  position: fixed;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.card-image {
  width: 80px;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
}

.card-price {
  font-size: 20px;
}

.card-actions {
  display: flex;
}

.btn-small {
  flex: 1;
  font-size: 18px;
}

.btn-small.btn-secondary {
  color: #666666;
}

.btn-small.btn-primary {
  color: #ffffff;
}

.help-modal {
  position: fixed;
}

.help-content {
  width: 100%;
  max-height: 70vh;
  overflow-y: auto;
}

.help-header {
  display: flex;
}

.help-title {
  font-size: 20px;
}

.close-btn {
  width: 32px;
}

.close-icon {
  width: 20px;
}

.help-steps {
  margin-bottom: 24px;
}

.help-step {
  display: flex;
}

.step-number {
  width: 36px;
}

.step-content {
  flex: 1;
  padding-top: 4px;
}

.step-title {
  font-size: 16px;
}

.step-desc {
  font-size: 14px;
}

.help-tips {
  background-color: var(--color-primary-light);
}

.tips-title {
  font-size: 15px;
}

.tip-item {
  margin-bottom: 8px;
}

.tip-item text {
  font-size: 14px;
}

.photo-preview-modal {
  position: fixed;
}

.photo-content {
  width: 100%;
}

.preview-photo {
  width: 100%;
}

.photo-actions {
  display: flex;
}

.font-large .title-text {
  font-size: 20px;
}

.font-large .loading-text, .font-large .error-title {
  font-size: 18px;
}

.font-large .error-desc, .font-large .hint-text, .font-large .btn-text {
  font-size: 16px;
}

.font-large .card-title {
  font-size: 18px;
}

.font-large .card-price {
  font-size: 22px;
}

.font-large .help-title {
  font-size: 22px;
}

.font-large .step-title, .font-large .tips-title {
  font-size: 17px;
}

.font-large .step-desc, .font-large .tip-item text {
  font-size: 15px;
}
