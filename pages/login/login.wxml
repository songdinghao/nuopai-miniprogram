<!-- pages/login/login.wxml - 登录页面模板 -->
<view class="login-page" style="font-size: {{fontSize === 'normal' ? '16px' : fontSize === 'large' ? '18px' : '20px'}}">

  <!-- 顶部返回 -->
  <view class="header">
    <view class="nav-bar">
      <view class="back-btn" bindtap="onBack">
        <text class="icon">×</text>
      </view>
    </view>
  </view>

  <view class="login-content">
    <!-- Logo和标题 -->
    <view class="brand-section">
      <view class="brand-logo">
        <text>💐</text>
      </view>
      <text class="brand-title">诺派永生花</text>
      <text class="brand-subtitle">美好生活，从这里开始</text>
    </view>

    <!-- 登录方式切换 -->
    <view class="login-tabs">
      <view class="login-tab {{loginType === 'wechat' ? 'active' : ''}}" bindtap="onChangeLoginType" data-type="wechat">
        <text>微信登录</text>
      </view>
      <view class="login-tab {{loginType === 'phone' ? 'active' : ''}}" bindtap="onChangeLoginType" data-type="phone">
        <text>手机登录</text>
      </view>
    </view>

    <!-- 微信登录 -->
    <view wx:if="{{loginType === 'wechat'}}" class="login-form">
      <view class="login-tip">
        <text>授权微信登录，畅享便捷购物体验</text>
      </view>

      <button class="wechat-login-btn" bindtap="onWechatLogin">
        <text class="btn-icon">💚</text>
        <text class="btn-text">一键微信登录</text>
      </button>

      <view class="login-agree">
        <view class="agree-checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
          <text wx:if="{{agreed}}">✓</text>
        </view>
        <text class="agree-text">我已阅读并同意</text>
        <text class="agree-link" bindtap="onShowAgreement">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link" bindtap="onShowPrivacy">《隐私政策》</text>
      </view>
    </view>

    <!-- 手机登录 -->
    <view wx:if="{{loginType === 'phone'}}" class="login-form">
      <!-- 手机号输入 -->
      <view class="input-group">
        <text class="input-label">手机号</text>
        <view class="input-box">
          <text class="input-prefix">+86</text>
          <input class="input-field" bindinput="onPhoneInput" maxlength="11" placeholder="请输入手机号" type="number" value="{{phone}}" />
      </view>
    </view>

    <!-- 验证码输入 -->
    <view class="input-group">
      <text class="input-label">验证码</text>
      <view class="input-box code-box">
        <input class="input-field code-input" bindinput="onCodeInput" maxlength="6" placeholder="请输入验证码" type="number" value="{{code}}" />
      <button class="code-btn {{countdown > 0 ? 'disabled' : ''}}"
      bindtap="onSendCode"
      disabled="{{countdown > 0}}"
      >
      <text wx:if="{{countdown > 0}}">{{countdown}}s</text>
      <text wx:else>获取验证码</text>
    </button>
  </view>
</view>

<button class="login-btn {{canLogin ? '' : 'disabled'}}" bindtap="onPhoneLogin" disabled="{{!canLogin}}">
  <text>登录</text>
</button>

<view class="login-agree">
  <view class="agree-checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
    <text wx:if="{{agreed}}">✓</text>
  </view>
  <text class="agree-text">我已阅读并同意</text>
  <text class="agree-link" bindtap="onShowAgreement">《用户协议》</text>
  <text class="agree-text">和</text>
  <text class="agree-link" bindtap="onShowPrivacy">《隐私政策》</text>
</view>
</view>

<!-- 其他登录方式 -->
<view class="other-login">
  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">其他登录方式</text>
    <view class="divider-line"></view>
  </view>

  <view class="other-methods">
    <view wx:if="{{loginType === 'phone'}}" class="other-method" bindtap="onChangeLoginType" data-type="wechat">
      <text class="method-icon">💚</text>
      <text class="method-text">微信</text>
    </view>

    <view wx:if="{{loginType === 'wechat'}}" class="other-method" bindtap="onChangeLoginType" data-type="phone">
      <text class="method-icon">📱</text>
      <text class="method-text">手机</text>
    </view>
  </view>
</view>
</view>
</view>
