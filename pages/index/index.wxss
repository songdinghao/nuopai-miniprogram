/* ============================================
   首页 - 诺派永生花·雅集美学
   目标用户: 30-60岁家庭主妇
   布局风格: 场景生活杂志风
   ============================================ */

@import '../../app.wxss'

/* ----- 顶部导航 ----- */
.index-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border-light);
}

.nav-brand {
  display: flex;
  align-items: center;
}

.nav-logo {
  font-size: 38rpx;
  font-weight: 500;
  color: var(--color-primary);
  letter-spacing: 4rpx;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.nav-btn {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform 0.2s;
}

.nav-btn:active {
  transform: scale(0.9);
}

.nav-btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.nav-btn-search {
  background: var(--bg-secondary);
}
.nav-btn-search .nav-btn-icon {
  color: var(--text-secondary);
}

.nav-btn-notify {
  background: #fdf2e9;
}
.nav-btn-notify .nav-btn-icon {
  color: var(--color-orange);
}

.nav-btn-cart {
  background: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(45, 140, 122, 0.25);
}
.nav-btn-cart .nav-btn-icon {
  color: #fff;
}

.nav-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 6rpx;
  background: var(--color-red);
  color: #fff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 17rpx;
  border: 2rpx solid #fff;
  font-weight: 500;
}

/* ----- 轮播横幅 ----- */
.hero-banner-wrap {
  margin: 16rpx 16rpx 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.hero-banner {
  width: 100%;
  height: 320rpx;
}

.hero-slide {
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.hero-content {
  display: flex;
  flex-direction: column;
  max-width: 65%;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 8rpx;
  line-height: 1.5;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(8rpx);
  font-size: 24rpx;
  color: #fff;
  align-self: flex-start;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* ----- 场景导航 ----- */
.section-spacing {
  margin-top: 8rpx;
}

.section-header {
  padding: 24rpx 20rpx 12rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 4rpx 0;
}

.scene-scroll {
  padding: 0 16rpx 16rpx;
  white-space: nowrap;
}

.scene-nav {
  display: flex;
  gap: 12rpx;
}

.scene-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 44rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-primary);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.scene-tag:active {
  transform: scale(0.95);
}

.scene-tag.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(45, 140, 122, 0.3);
}

.scene-emoji {
  font-size: 28rpx;
}

.scene-label {
  font-size: 26rpx;
}

/* ----- 商品双列网格 ----- */
.product-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 16rpx;
}

.product-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.product-card:active {
  transform: scale(0.97);
}

.product-img {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  overflow: hidden;
  background: var(--bg-color);
}

.product-img image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-img .product-emoji {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 60rpx;
}

.product-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(45, 140, 122, 0.9);
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(6rpx);
}

.product-scene-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  margin-bottom: 8rpx;
  border-radius: 6rpx;
  background: #FAEEDA;
  color: #C9A96E;
  font-size: 22rpx;
  font-weight: 500;
}

.product-info {
  padding: 20rpx 16rpx 24rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.product-price {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.product-oldprice {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

/* ----- 促销 CTA 横幅 ----- */
.cta-banner {
  margin: 16rpx 16rpx;
  padding: 28rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #CBA34E 0%, #B8954A 50%, #A68A3A 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 24rpx rgba(201, 169, 110, 0.3);
}

.cta-banner:active {
  opacity: 0.9;
}

.cta-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cta-emoji {
  font-size: 48rpx;
}

.cta-texts {
  display: flex;
  flex-direction: column;
}

.cta-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  letter-spacing: 1rpx;
}

.cta-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.cta-arrow {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* ----- 场景搭配卡片 ----- */
.scene-bundle-scroll {
  padding: 0 16rpx 20rpx;
  white-space: nowrap;
}

.bundle-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  margin-right: 16rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.bundle-card:active {
  transform: scale(0.96);
}

.bundle-img {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bundle-emoji {
  font-size: 56rpx;
}

.bundle-info {
  padding: 16rpx 18rpx 20rpx;
}

.bundle-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.bundle-desc {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ----- 优惠券弹窗 ----- */
.coupon-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.coupon-modal {
  width: 86%;
  max-width: 640rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.coupon-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.coupon-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.coupon-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  background: var(--bg-color);
}

.coupon-body {
  padding: 0 32rpx 16rpx;
  max-height: 480rpx;
  overflow-y: auto;
}

.coupon-item {
  display: flex;
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.coupon-left {
  width: 160rpx;
  background: linear-gradient(135deg, var(--color-primary-light), rgba(201, 169, 110, 0.15));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
}

.coupon-amount {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.coupon-condition {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.coupon-right {
  flex: 1;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.coupon-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}

.coupon-claim-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-pink-mid));
  color: #fff;
  font-size: 24rpx;
  border-radius: 32rpx;
  align-self: flex-start;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(45, 140, 122, 0.2);
}

.coupon-claim-btn.claimed {
  background: var(--border-color);
  color: var(--text-disabled);
  box-shadow: none;
}

.coupon-footer {
  padding: 24rpx 32rpx;
  text-align: center;
  border-top: 1rpx solid var(--border-light);
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 骨架屏 ===== */
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

.skeleton-img {
  background: linear-gradient(90deg, var(--bg-color) 25%, var(--bg-secondary) 50%, var(--bg-color) 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, var(--bg-color) 25%, var(--bg-secondary) 50%, var(--bg-color) 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.skeleton-line.w80 { width: 80%; }
.skeleton-line.w60 { width: 60%; }
.skeleton-line.w40 { width: 40%; }

.hero-banner-skeleton {
  width: calc(100% - 32rpx);
  height: 320rpx;
  margin: 16rpx 16rpx 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.hero-skeleton-slide {
  width: 100%;
  height: 100%;
}

.product-card-skeleton {
  pointer-events: none;
}

.product-card-skeleton .product-img {
  width: 100%;
  height: 280rpx;
  padding-bottom: 0;
}

.product-card-skeleton .product-info {
  padding: 20rpx;
}

.skeleton-scroll {
  display: flex;
  white-space: nowrap;
}

.bundle-skeleton {
  display: inline-block;
  width: 280rpx;
  margin-right: 16rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  pointer-events: none;
}

.bundle-skeleton .bundle-img {
  width: 100%;
  height: 200rpx;
}

.bundle-skeleton .bundle-info {
  padding: 20rpx;
}

/* ===== 模块错误状态 ===== */
.module-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.module-retry {
  margin-top: 24rpx;
  padding: 18rpx 44rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: var(--shadow-primary);
}

/* ===== 字体适配 ===== */
.font-large .hero-title { font-size: 40rpx; }
.font-large .product-name { font-size: 30rpx; }
.font-large .product-price { font-size: 36rpx; }
.font-large .section-title { font-size: 34rpx; }
.font-large .scene-label { font-size: 28rpx; }

.font-extra-large .hero-title { font-size: 44rpx; }
.font-extra-large .product-name { font-size: 32rpx; }
.font-extra-large .product-price { font-size: 38rpx; }
.font-extra-large .section-title { font-size: 36rpx; }
.font-extra-large .scene-label { font-size: 30rpx; }
