.promotion-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
  margin-bottom: 0;
  margin-right: 16rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.error-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.error-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.error-btn {
  padding: 20rpx 60rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 轮播Banner优化 */
.banner-swiper {
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 20rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(45, 140, 122, 0.15);
  width: calc(100% - 48rpx);
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
  background-color: var(--border-light);
  border-radius: 16rpx;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* 活动信息卡片优化 */
.activity-info {
  background: linear-gradient(135deg, #2D8C7A 0%, #3AA99E 100%);
  margin: -40rpx 24rpx 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 32rpx rgba(45, 140, 122, 0.2);
  color: #ffffff;
}

.activity-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.activity-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.25) !important;
  backdrop-filter: blur(10px);
}

.activity-tag text {
  font-size: 22rpx;
  color: #ffffff !important;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.activity-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff !important;
  margin-right: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.activity-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9) !important;
  margin-top: 12rpx;
  width: 100%;
  line-height: 1.6;
}

.activity-time {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255,255,255,0.3);
}

.time-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.time-value {
  font-size: 26rpx;
  color: #ffffff !important;
  font-weight: 600;
}

.product-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #2D8C7A, #3AA99E);
  border-radius: 3rpx;
}

.section-count {
  font-size: 26rpx;
  color: #999999;
  background: var(--bg-secondary);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

/* 商品卡片优化 */
.product-item {
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
}

.product-item:active {
  transform: translateY(-8rpx);
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.12);
}

.product-image {
  width: 100%;
  height: 320rpx;
  background-color: var(--bg-secondary);
}

.product-info {
  padding: 24rpx;
}

.product-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
  min-height: 78rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

/* 价格标签醒目 */
.current-price {
  font-size: 36rpx;
  color: #E8734A !important;
  font-weight: 700;
  margin-right: 12rpx;
}

.original-price {
  font-size: 22rpx;
  color: #999999;
  text-decoration: line-through;
}

.product-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sales-text {
  font-size: 22rpx;
  color: #999999;
}

.discount-tag {
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #FF6B6B, #EE5A24);
  border-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(238, 90, 36, 0.3);
}

.discount-tag text {
  font-size: 20rpx;
  color: white;
  font-weight: 600;
}

.loading-more, .no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-more-text, .no-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* 活动规则优化 */
.rules-section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx 32rpx 36rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.rules-list {
  padding-top: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.rule-item:active {
  background: #e8f5e9;
}

.rule-dot {
  font-size: 28rpx;
  color: var(--color-primary);
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: 700;
}

.rule-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.card {
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
