.feedback-page {
  background-color: #F8F8F8;
  min-height: 100vh;
  padding: 24rpx;
}

.section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}

.section-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.type-list {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F5F5;
  transition: all 0.3s;
}

.type-item.active {
  background-color: #2D8C7A;
  color: #FFFFFF;
}

.textarea-wrap {
  position: relative;
}

.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.text-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 22rpx;
  color: #CCCCCC;
}

.contact-input {
  width: 100%;
  height: 88rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-section {
  margin-top: 48rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background-color: #2D8C7A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after {
  border: none;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
