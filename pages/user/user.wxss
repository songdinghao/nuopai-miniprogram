.user-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 快捷导航栏 */
.quick-nav {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  gap: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.quick-nav-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  position: relative;
  padding: 8rpx 12rpx;
}

.quick-nav-icon {
  font-size: 28rpx;
}

.quick-nav-text {
  font-size: 24rpx;
  color: #666666;
}

.quick-nav-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #2D8C7A;
  color: #FFFFFF;
  font-size: 18rpx;
  border-radius: 16rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.user-header {
  background: linear-gradient(135deg, var(--color-primary), var(--color-warm));
  padding: 40rpx 24rpx 24rpx;
  position: relative;
  overflow: hidden;
}

.user-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.user-info-section {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar-section {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-icon {
  font-size: 60rpx;
}

.login-prompt {
  display: flex;
  flex-direction: column;
}

.login-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.user-level {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.settings-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.settings-icon .icon {
  font-size: 32rpx;
}

.member-card {
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
  background: rgba(0, 0, 0, 0.2);
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.member-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.member-points, .member-coupons, .member-favorites {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.member-info-loading {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
}

.member-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.order-section {
  background-color: #ffffff;
  margin: -20rpx 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 2;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.section-more {
  display: flex;
  align-items: center;
}

.more-text {
  font-size: 24rpx;
  color: #999999;
  margin-right: 4rpx;
}

.more-icon {
  font-size: 28rpx;
  color: #999999;
}

.order-entries {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 8rpx 12rpx;
}

.entry-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.entry-label {
  font-size: 24rpx;
  color: #666666;
}

.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: var(--color-primary);
  border-radius: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.badge-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 500;
}

.menu-section {
  margin: 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  position: relative;
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 72rpx;
  right: 0;
  height: 1rpx;
  background-color: var(--border-light);
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-value {
  font-size: 24rpx;
  color: #999999;
  margin-right: 8rpx;
}

.menu-badge {
  background-color: var(--color-primary);
  border-radius: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.menu-badge .badge-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 500;
}

.menu-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

.logout-section {
  margin: 40rpx 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: #ffffff;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn::after {
  border: none;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.user-page.font-large .login-text {
  font-size: 36rpx;
}

.user-page.font-large .user-name {
  font-size: 36rpx;
}

.user-page.font-large .section-title {
  font-size: 34rpx;
}

.user-page.font-large .menu-label {
  font-size: 32rpx;
}

.user-page.font-large .logout-btn {
  font-size: 34rpx;
}

.user-page.font-xlarge .login-text {
  font-size: 40rpx;
}

.user-page.font-xlarge .user-name {
  font-size: 40rpx;
}

.user-page.font-xlarge .section-title {
  font-size: 38rpx;
}

.user-page.font-xlarge .menu-label {
  font-size: 36rpx;
}

.user-page.font-xlarge .logout-btn {
  font-size: 38rpx;
}


.mom-entry-section {
  margin: 0 24rpx 16rpx;
}

.mom-entry-card {
  background: linear-gradient(135deg, #2D8C7A, #E8734A);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4px 16px rgba(45, 140, 122, 0.25);
}

.mom-entry-card.active {
  background: linear-gradient(135deg, #3AA99E, #2D8C7A);
}

.mom-entry-content {
  flex: 1;
}

.mom-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
}

.mom-entry-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.mom-entry-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.mom-entry-btn {
  font-size: 24rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  text-align: center;
}

.mom-entry-btn.primary {
  background: rgba(255, 255, 255, 0.95);
  color: #2D8C7A;
}

.mom-entry-btn.outline {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.mom-stats-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.mom-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mom-stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.mom-stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.mom-stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.3);
}
