<!-- pages/user/history/history.wxml - 浏览历史页面 -->
<view class="history-page">
  <!-- 空状态 -->
  <view wx:if="{{!loading && isEmpty}}" class="empty-wrap">
    <view class="empty-icon">📜</view>
    <text class="empty-title">暂无浏览记录</text>
    <text class="empty-desc">快去逛逛吧，发现心仪好物</text>
    <view class="empty-btn" bindtap="onGoHome">去逛逛</view>
  </view>

  <!-- 历史列表 -->
  <block wx:if="{{!loading && !isEmpty}}">
    <view class="history-header">
      <text class="history-count">共 {{historyList.length}} 条记录</text>
      <view class="clear-btn" bindtap="onClearHistory">
        <text class="clear-text">清空</text>
      </view>
    </view>

    <view class="history-list">
      <view wx:for="{{historyList}}" wx:key="id" class="history-item">
        <view class="item-content" bindtap="onItemTap" data-id="{{item.id}}">
          <image class="item-image" mode="aspectFill" src="{{item.image}}" />
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <view class="item-bottom">
              <text class="item-price">¥{{item.price}}</text>
              <text class="item-time">{{item.timeText}}</text>
            </view>
          </view>
        </view>
        <view class="item-delete" catchtap="onDeleteItem" data-id="{{item.id}}">
          <text class="delete-text">删除</text>
        </view>
      </view>
    </view>
  </block>
</view>
