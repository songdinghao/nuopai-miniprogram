.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, #ffffff 40%);
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
  z-index: 0;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.3;
}

.circle.c1 {
  width: 400rpx;
  height: 400rpx;
  background: var(--color-primary);
  top: -100rpx;
  right: -80rpx;
}

.circle.c2 {
  width: 250rpx;
  height: 250rpx;
  background: #5baf9e;
  top: 50rpx;
  left: -60rpx;
}

.circle.c3 {
  width: 180rpx;
  height: 180rpx;
  background: #8dd4c4;
  bottom: -30rpx;
  right: 100rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 60rpx 32rpx 48rpx;
}

.hero-section {
  text-align: center;
  padding: 40rpx 0 48rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  display: block;
}

.hero-subtitle {
  font-size: 28rpx;
  color: var(--color-primary);
  margin-top: 16rpx;
  display: block;
  font-weight: 500;
}

.benefits-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 107, 157, 0.1);
  margin-bottom: 48rpx;
}

.benefits-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 28rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--bg-color));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.icon-text {
  font-size: 32rpx;
}

.benefit-content {
  flex: 1;
}

.benefit-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.benefit-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
}

.action-section {
  text-align: center;
}

.btn-activate {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-pink-mid));
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  position: relative;
}

.btn-activate::after {
  border: none;
}

.btn-activate-text {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
  display: block;
  line-height: 1.3;
}

.btn-activate-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  line-height: 1.3;
  margin-top: 4rpx;
}

.agreement {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.agreement-link {
  font-size: 24rpx;
  color: var(--color-primary);
  text-decoration: underline;
}
