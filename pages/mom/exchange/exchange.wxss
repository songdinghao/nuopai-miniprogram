.page {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.balance-bar {
  background: linear-gradient(135deg, var(--color-primary), var(--color-pink-mid));
  padding: 32rpx;
  text-align: center;
  color: #ffffff;
}

.bar-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.bar-amount {
  font-size: 64rpx;
  font-weight: 600;
  margin: 8rpx 0;
}

.bar-hint {
  font-size: 24rpx;
  opacity: 0.85;
}

.product-list {
  margin: 24rpx 32rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.product-item {
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.product-img {
  width: 100%;
  height: 240rpx;
  background: var(--bg-secondary);
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 26rpx;
  color: #333333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-top: 8rpx;
  display: block;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal.show {
  display: flex;
}

.modal-content {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx;
  width: 560rpx;
  text-align: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-desc {
  font-size: 28rpx;
  color: #666666;
  margin: 16rpx 0;
}

.modal-price {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin: 20rpx 0;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-cancel {
  background: var(--bg-secondary);
  color: #666666;
}

.btn-confirm {
  background: var(--color-primary);
  color: #ffffff;
}
