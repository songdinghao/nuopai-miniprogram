/* pages/mom/home/home.wxss - 妈妈体验官主页样式（精美现代风格） */

/* ==================== 全局变量 ==================== */
page {
  background: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* ==================== 页面容器 ==================== */
.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.mom-home-page {
  background: #F5F5F5;
}

/* ==================== 引导浮层 ==================== */
.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
}

.guide-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.guide-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D8C7A;
  display: block;
  text-align: center;
}

.guide-subtitle {
  font-size: 28rpx;
  color: #666666;
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}

.guide-steps {
  margin-bottom: 40rpx;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2D8C7A 0%, #3AA99E 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  line-height: 1.5;
}

.guide-arrow {
  text-align: center;
  color: #2D8C7A;
  font-size: 32rpx;
  margin: 8rpx 0;
}

.btn-guide-done {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #2D8C7A 0%, #3AA99E 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  margin-top: 16rpx;
}

.btn-guide-done::after {
  border: none;
}

/* ==================== 顶部收益卡片 ==================== */
.earnings-header {
  position: relative;
  padding: 40rpx 30rpx 80rpx;
  background: linear-gradient(135deg, #2D8C7A 0%, #3AA99E 100%);
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
  background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.3) 0%, transparent 60%),
              radial-gradient(circle at 70% 80%, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title-section {
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

/* ==================== 收益卡片 ==================== */
.earnings-card {
  position: relative;
  z-index: 2;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 4px 16px rgba(45, 140, 122, 0.15);
}

.earnings-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.earning-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.earning-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #2D8C7A;
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

.earning-value.pending {
  color: #E8734A;
}

.earning-value.settled {
  color: #52C41A;
}

.earning-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  text-align: center;
}

.earning-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E8E8E8;
}

/* ==================== 用户等级部分 ==================== */
.user-level-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.level-badge.newbie {
  background: #E8F5E9;
  color: #2D8C7A;
}

.level-badge.regular {
  background: #FFF3E0;
  color: #E8734A;
}

.level-desc {
  font-size: 22rpx;
  color: #999999;
  margin-left: 16rpx;
}

.invite-code {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* ==================== 功能入口区域 ==================== */
.menu-section {
  margin: -40rpx 24rpx 24rpx;
  position: relative;
  z-index: 3;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-date {
  font-size: 24rpx;
  color: #999999;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  transition: all 0.3s ease;
}

.menu-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.bg-material {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.bg-rewards {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.bg-withdraw {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
}

.bg-rules {
  background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%);
}

.bg-service {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD0 100%);
}

.bg-notification {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
}

.menu-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  text-align: center;
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 20rpx;
  color: #999999;
  display: block;
  text-align: center;
}

/* ==================== 当月数据区域 ==================== */
.monthly-section {
  margin: 24rpx;
}

.monthly-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.monthly-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.monthly-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D8C7A;
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

.monthly-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  text-align: center;
}

.monthly-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E8E8E8;
}

/* ==================== 小贴士区域 ==================== */
.tips-section {
  margin: 24rpx;
}

.tips-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #E8734A;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.tips-content {
  padding-left: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #666666;
  display: block;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* ==================== 安全区域 ==================== */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
  padding-bottom: 32rpx;
}

/* ==================== 大字体模式兼容 ==================== */
.page.font-large .header-title {
  font-size: 42rpx;
}

.page.font-large .earning-value {
  font-size: 42rpx;
}

.page.font-large .menu-name {
  font-size: 30rpx;
}

.page.font-large .monthly-value {
  font-size: 38rpx;
}

.page.font-large .section-title {
  font-size: 36rpx;
}

.page.font-large .tips-title {
  font-size: 34rpx;
}

.page.font-large .tips-text {
  font-size: 28rpx;
}

/* ==================== 超大字体模式兼容 ==================== */
.page.font-extra-large .header-title {
  font-size: 48rpx;
}

.page.font-extra-large .earning-value {
  font-size: 48rpx;
}

.page.font-extra-large .menu-name {
  font-size: 34rpx;
}

.page.font-extra-large .monthly-value {
  font-size: 44rpx;
}

.page.font-extra-large .section-title {
  font-size: 42rpx;
}

.page.font-extra-large .tips-title {
  font-size: 40rpx;
}

.page.font-extra-large .tips-text {
  font-size: 32rpx;
}

/* ==================== 响应式布局优化 ==================== */
@media (min-width: 768px) {
  .menu-grid {
    grid-template-columns: repeat(6, 1fr);
  }

  .earnings-card {
    padding: 48rpx;
  }

  .monthly-card {
    padding: 48rpx 32rpx;
  }
}

/* ==================== 动画效果 ==================== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.earnings-card {
  animation: fadeInUp 0.6s ease-out;
}

.menu-section {
  animation: fadeInUp 0.8s ease-out;
}

.monthly-section {
  animation: fadeInUp 1s ease-out;
}

/* ==================== 无障碍访问优化 ==================== */
.menu-item:focus {
  outline: 2rpx solid #2D8C7A;
  outline-offset: 4rpx;
}

button:focus {
  outline: 2rpx solid #2D8C7A;
  outline-offset: 4rpx;
}
