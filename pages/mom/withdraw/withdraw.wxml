<view class="page withdraw-page">
  <!-- 余额卡片 -->
  <view class="balance-card">
    <text class="balance-label">可提现余额（元）</text>
    <text class="balance-amount">¥{{formattedBalance}}</text>
    <text class="balance-hint">最低提现{{minWithdrawFormatted}}元 · 微信零钱实时到账</text>
  </view>

  <!-- 提现表单 -->
  <view class="withdraw-form">
    <view class="form-row">
      <text class="form-label">提现金额</text>
      <input 
        class="form-input" 
        bindinput="onAmountInput" 
        placeholder="输入金额" 
        type="digit" 
        value="{{withdrawAmount}}"
      />
      <text class="form-unit">元</text>
    </view>

    <view class="form-tips">
      <text class="tip-item">• 收款方式：微信零钱</text>
      <text class="tip-item">• 到账时间：实时到账</text>
      <text class="tip-item">• 手续费：免手续费</text>
    </view>

    <view class="form-actions">
      <button class="btn-all" bindtap="onWithdrawAll">全部提现</button>
      <button class="btn-submit {{submitting?'disabled':''}}" bindtap="onWithdraw" disabled="{{submitting}}">
        {{submitting ? '处理中...' : '确认提现'}}
      </button>
    </view>
  </view>

  <!-- 收益兑换入口 -->
  <view class="exchange-entry" bindtap="onExchangeProduct">
    <text class="entry-icon">🔄</text>
    <view class="entry-info">
      <text class="entry-title">收益兑换商品</text>
      <text class="entry-desc">收益1:1兑换永生花商品</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <!-- 提现记录 -->
  <view wx:if="{{withdrawHistory.length > 0}}" class="history-section">
    <view class="section-title">提现记录</view>
    <view wx:for="{{withdrawHistory}}" wx:key="id" class="history-item">
      <view class="hist-left">
        <text class="hist-amount">¥{{item.amount}}</text>
        <text class="hist-time">{{item.formattedCreatedAt}}</text>
      </view>
      <text class="hist-status {{item.status}}">
        {{item.status==='processing'?'处理中':item.status==='completed'?'已到账':'失败'}}
      </text>
    </view>
  </view>

  <!-- 加载提示 -->
  <view wx:if="{{isLoading}}" class="loading-mask">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>
