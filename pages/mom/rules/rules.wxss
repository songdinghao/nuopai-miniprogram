page {
  background: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-header {
  display: flex;
  align-items: center;
  padding: 88rpx 32rpx 24rpx;
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--bg-color) 100%);
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  min-height: 44px;
  min-width: 44px;
}

.back-icon {
  font-size: 18px;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.back-text {
  font-size: 15px;
  color: var(--text-secondary);
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 18px;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 80rpx;
}

.search-bar {
  position: relative;
  margin: 20rpx 32rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 48px;
  background: #ffffff;
  border-radius: 24px;
  padding: 0 72rpx 0 80rpx;
  font-size: 15px;
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.search-input:focus {
  border-color: var(--color-primary);
}

.search-icon {
  position: absolute;
  left: 24rpx;
  font-size: 16px;
  pointer-events: none;
}

.search-clear {
  position: absolute;
  right: 24rpx;
  font-size: 14px;
  color: var(--text-tertiary);
  padding: 8rpx;
}

.search-results {
  margin: 0 32rpx 16rpx;
  background: #ffffff;
  border-radius: 12px;
  padding: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.search-result-item {
  padding: 16rpx;
  border-bottom: 1rpx solid var(--bg-secondary);
  min-height: 44px;
}

.search-result-item:last-child {
  border-bottom: none;
}

.result-section {
  display: block;
  font-size: 13px;
  color: var(--color-primary);
  margin-bottom: 4rpx;
}

.result-text {
  display: block;
  font-size: 15px;
  color: var(--text-primary);
  line-height: 1.5;
}

.search-empty {
  text-align: center;
  padding: 48rpx;
}

.search-empty .empty-hint {
  font-size: 15px;
  color: var(--text-tertiary);
}

.rules-content {
  flex: 1;
  padding: 0 32rpx;
}

.quick-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 12px;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
  min-height: 44px;
  min-width: 44px;
}

.nav-dot {
  font-size: 10px;
  color: var(--color-primary);
  margin-right: 8rpx;
}

.nav-text {
  font-size: 15px;
  color: var(--text-secondary);
}

.rule-section {
  margin-bottom: 24rpx;
}

.rule-title {
  font-size: 17px;
  font-weight: 500;
  color: var(--color-primary);
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.rule-card {
  background: #ffffff;
  border-radius: 12px;
  padding: 8rpx 24rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.rule-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg-secondary);
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-point {
  display: block;
  font-size: 16px;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.rule-desc {
  display: block;
  font-size: 15px;
  color: var(--text-secondary);
  line-height: 1.6;
}

.bottom-space {
  height: 80rpx;
}

.page.font-large .page-title {
  font-size: 20px;
}

.page.font-large .search-input {
  font-size: 17px;
}

.page.font-large .nav-text {
  font-size: 17px;
}

.page.font-large .rule-title {
  font-size: 19px;
}

.page.font-large .rule-point {
  font-size: 18px;
}

.page.font-large .rule-desc {
  font-size: 17px;
}

.page.font-extra-large .page-title {
  font-size: 22px;
}

.page.font-extra-large .search-input {
  font-size: 19px;
}

.page.font-extra-large .nav-text {
  font-size: 19px;
}

.page.font-extra-large .rule-title {
  font-size: 21px;
}

.page.font-extra-large .rule-point {
  font-size: 20px;
}

.page.font-extra-large .rule-desc {
  font-size: 19px;
}
