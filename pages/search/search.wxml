<!--pages/search/search.wxml - 搜索页面（针对30-60岁主妇优化）-->
<view class="page-container search-page" style="font-size: {{fontSize === 'normal' ? '16px' : fontSize === 'large' ? '18px' : '20px'}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <image class="back-icon" src="/assets/icons/arrow-left.png" />
</view>

<!-- 搜索框 -->
<view class="search-box">
  <image class="search-icon" src="/assets/icons/search.png" />
<input class="search-input" bindconfirm="onSearchConfirm" bindinput="onSearchInput" focus="{{showSearchInput}}" placeholder="搜索永生花、客厅摆件" placeholder-class="search-placeholder" value="{{searchKeyword}}" />
<view wx:if="{{searchKeyword}}" class="clear-btn" bindtap="onClearSearch">
  <image class="clear-icon" src="/assets/icons/close-small.png" />
</view>
</view>

<view class="search-btn" bindtap="onSearchTap">
  <text class="search-btn-text">搜索</text>
</view>
</view>

<!-- 搜索联想浮层 -->
<view wx:if="{{showSuggestions}}" class="suggestions-overlay" catchtap="onHideSuggestions">
  <view class="suggestions-panel">
    <block wx:for="{{suggestions}}" wx:key="index">
      <view class="suggestion-item" bindtap="onSuggestionTap" data-index="{{index}}">
        <image class="suggestion-icon" src="/assets/icons/search.png" />
    <text class="suggestion-text">{{item.text}}</text>
  </view>
</block>
</view>
</view>

<scroll-view bindscrolltolower="onLoadMore" refresher-enabled="{{false}}" scroll-y class="scroll-view">
  <!-- 搜索前：显示历史和热搜 -->
  <view wx:if="!searching && searchResults.length === 0" class="search-pre">
    <!-- 搜索历史 -->
    <view wx:if="{{searchHistory.length > 0 && showHistory}}" class="history-section">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-history" bindtap="onClearHistory">清空</text>
      </view>
      <view class="history-list">
        <block wx:for="{{searchHistory}}" wx:key="index">
          <view class="history-item" bindtap="onHistoryTap" data-index="{{index}}">
            <image class="history-icon" src="/assets/icons/search.png" />
        <text class="history-text">{{item}}</text>
        <view class="delete-btn" catchtap="onDeleteHistoryItem" data-index="{{index}}">
          <image class="delete-icon" src="/assets/icons/close-small.png" />
    </view>
  </view>
</block>
</view>
</view>

<!-- 热搜词 -->
<view wx:if="{{showHotKeywords}}" class="hot-section">
  <view class="section-header">
    <text class="section-title">大家都在搜</text>
  </view>
  <view class="hot-list">
    <block wx:for="{{hotKeywords}}" wx:key="id">
      <view class="hot-item {{item.hot ? 'hot-tag' : ''}}" bindtap="onHotKeywordTap" data-index="{{index}}">
        <text wx:if="{{item.hot}}" class="hot-index">{{index + 1}}</text>
        <text class="hot-text">{{item.name}}</text>
      </view>
    </block>
  </view>
</view>

<empty-state wx:if="{{emptyState.show}}" title="{{emptyState.title}}" description="{{emptyState.desc}}" type="search"></empty-state>
</view>

<!-- 搜索中：显示加载状态 -->
<view wx:if="{{searching}}" class="searching-state">
  <view class="loading-spinner"></view>
  <text class="loading-text">搜索中...</text>
</view>

<!-- 搜索后：显示结果 -->
<view wx:if="!searching && searchResults.length > 0" class="search-results">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="category-list">
        <block wx:for="{{categories}}" wx:key="id">
          <view class="category-item {{item.selected ? 'active' : ''}}" bindtap="onCategoryTap" data-index="{{index}}">
            <text class="category-text">{{item.name}}</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <view class="sort-dropdown">
      <view class="sort-btn" bindtap="toggleSort">
        <text class="sort-text">{{currentSortText}}</text>
        <image class="sort-icon" src="/assets/icons/arrow-down.png" />
  </view>
</view>
</view>

<!-- 排序菜单 -->
<view wx:if="{{showSortMenu}}" class="sort-menu" catchtap="hideSortMenu">
  <view class="sort-mask" bindtap="hideSortMenu"></view>
  <view class="sort-options">
    <block wx:for="{{sortOptions}}" wx:key="id">
      <view class="sort-option {{item.selected ? 'active' : ''}}" bindtap="onSortTap" data-index="{{index}}">
        <text class="sort-option-text">{{item.name}}</text>
        <image wx:if="{{item.selected}}" class="check-icon" src="/assets/icons/check.png" />
  </view>
</block>
</view>
</view>

<!-- 搜索结果统计 -->
<view class="result-count">
  <text class="count-text">找到 {{searchResults.length}} 个商品</text>
</view>

<view class="product-list">
  <block wx:for="{{searchResults}}" wx:key="id">
    <view class="product-item card" bindtap="onProductTap" data-index="{{index}}">
      <image class="product-image" mode="aspectFill" src="{{item.image}}" />
  <view class="product-info">
    <view class="product-name">
      <text>{{item.name}}</text>
    </view>

    <view class="product-meta">
      <view class="match-tag">
        <text>{{item.match}}%匹配</text>
      </view>
      <view class="sales-info">
        <text>已售{{item.sales}}</text>
      </view>
    </view>

    <view class="product-price">
      <text class="current-price">¥{{item.price}}</text>
      <text wx:if="{{item.originalPrice}}" class="original-price">¥{{item.originalPrice}}</text>
    </view>

    <view wx:if="{{item.tags && item.tags.length > 0}}" class="product-tags">
      <block wx:for="{{item.tags}}" wx:key="index">
        <view class="tag-item">
          <text>{{item}}</text>
        </view>
      </block>
    </view>
  </view>
</view>
</block>
</view>

<!-- 加载更多 -->
<view wx:if="{{loading}}" class="loading-more">
  <view class="loading-spinner small"></view>
  <text class="loading-more-text">加载中...</text>
</view>

<view wx:if="!hasMore && searchResults.length > 0" class="no-more">
  <text class="no-more-text">已显示全部商品</text>
</view>
</view>

<view class="safe-area-bottom"></view>
</scroll-view>

<!-- 语音搜索浮层 -->
<view wx:if="{{voiceSearching}}" class="voice-overlay">
  <view class="voice-modal">
    <view class="voice-animation">
      <view class="voice-wave"></view>
      <view class="voice-wave"></view>
      <view class="voice-wave"></view>
    </view>
    <text class="voice-tip">请说出你想找的商品...</text>
    <text class="voice-time">最长10秒</text>
    <button class="btn-secondary voice-stop-btn" bindtap="onVoiceSearchStop">
      结束录音
    </button>
  </view>
</view>

<view class="voice-float-btn" bindtap="onVoiceSearchTap">
  <image class="voice-float-icon" src="/assets/icons/microphone-white.png" />
</view>
</view>
