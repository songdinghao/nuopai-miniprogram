.search-page {
  background-color: var(--bg-color);
  min-height: 100vh;
}

.page-container {
  font-family: -apple-system, BlinkMacSystemFont, 
               "PingFang SC", "Hiragino Sans GB", 
               "Microsoft YaHei", "Helvetica Neue", 
               Helvetica, Arial, sans-serif;
}

.nav-bar {
  height: 88px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.nav-back {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 20px;
  height: 20px;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 48px;
  background-color: var(--bg-secondary);
  border-radius: 24px;
  padding: 0 16px;
  gap: 12px;
}

.search-icon {
  width: 20px;
  height: 20px;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 16px;
  color: var(--text-primary);
  height: 32px;
  line-height: 32px;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: 15px;
}

.clear-btn {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  width: 16px;
  height: 16px;
  opacity: 0.4;
}

.search-btn {
  padding: 0 16px;
}

.search-btn-text {
  font-size: 16px;
  font-weight: 500;
  color: var(--color-primary);
}

.suggestions-overlay {
  position: fixed;
  top: 88px;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background-color: rgba(0, 0, 0, 0.3);
}

.suggestions-panel {
  background-color: #ffffff;
  padding: 8px 0;
  max-height: 400px;
  overflow-y: auto;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--bg-secondary);
}

.suggestion-item:active {
  background-color: var(--color-primary-light);
}

.suggestion-icon {
  width: 16px;
  height: 16px;
  opacity: 0.4;
  flex-shrink: 0;
}

.suggestion-text {
  font-size: 15px;
  color: var(--text-primary);
  line-height: 1.4;
}

.suggestion-highlight {
  color: var(--color-primary);
  font-weight: 500;
}

.scroll-view {
  height: calc(100vh - 88px);
}

.search-pre {
  padding: 20px 16px;
}

.history-section, .hot-section {
  margin-bottom: 32px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.section-title {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-primary);
}

.clear-history {
  font-size: 14px;
  color: var(--text-tertiary);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background-color: #ffffff;
  border-radius: 20px;
  border: 1px solid var(--border-color);
}

.history-icon {
  width: 16px;
  height: 16px;
  opacity: 0.4;
}

.history-text {
  font-size: 15px;
  color: var(--text-secondary);
}

.delete-btn {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  width: 12px;
  height: 12px;
  opacity: 0.3;
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.hot-item {
  padding: 10px 20px;
  background-color: #ffffff;
  border-radius: 20px;
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
}

.hot-item.hot-tag {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
}

.hot-item.hot-tag .hot-text {
  color: var(--color-primary);
  font-weight: 500;
}

.hot-index {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-primary);
}

.hot-text {
  font-size: 15px;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120px;
}

.empty-icon {
  width: 120px;
  height: 120px;
  margin-bottom: 24px;
  opacity: 0.3;
}

.empty-title {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: var(--text-tertiary);
}

.searching-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--bg-hover);
  border-top: 3px solid var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 16px;
  color: var(--text-tertiary);
}

.search-results {
  padding-bottom: 80px;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  background-color: #ffffff;
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 50;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 12px;
}

.category-item {
  padding: 8px 16px;
  background-color: var(--bg-secondary);
  border-radius: 20px;
  white-space: nowrap;
}

.category-item.active {
  background-color: var(--color-primary);
}

.category-item.active .category-text {
  color: #ffffff;
  font-weight: 500;
}

.category-text {
  font-size: 14px;
  color: var(--text-secondary);
}

.sort-dropdown {
  position: relative;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 12px;
  background-color: var(--bg-secondary);
  border-radius: 16px;
}

.sort-text {
  font-size: 14px;
  color: var(--text-secondary);
}

.sort-icon {
  width: 12px;
  height: 12px;
  opacity: 0.5;
}

.sort-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.sort-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.sort-options {
  position: absolute;
  top: 120px;
  right: 16px;
  background-color: #ffffff;
  border-radius: 12px;
  padding: 8px 0;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.16);
  min-width: 200px;
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  gap: 12px;
}

.sort-option.active .sort-option-text {
  color: var(--color-primary);
  font-weight: 500;
}

.sort-option-text {
  font-size: 15px;
  color: var(--text-primary);
}

.check-icon {
  width: 18px;
  height: 18px;
}

.result-count {
  padding: 12px 16px;
}

.count-text {
  font-size: 14px;
  color: var(--text-tertiary);
}

.product-list {
  padding: 0 16px;
}

.product-item {
  display: flex;
  gap: 12px;
  padding: 12px;
  border-radius: 12px;
  margin-bottom: 12px;
}

.product-image {
  width: 120px;
  height: 120px;
  border-radius: 8px;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.product-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.match-tag {
  padding: 2px 8px;
  background-color: #e8f7f2;
  border-radius: 4px;
}

.match-tag text {
  font-size: 11px;
  color: #28a679;
}

.sales-info text {
  font-size: 12px;
  color: var(--text-tertiary);
}

.product-price {
  display: flex;
  align-items: center;
  gap: 8px;
}

.current-price {
  font-size: 20px;
  font-weight: 600;
  color: var(--color-primary);
}

.original-price {
  font-size: 14px;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.product-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.tag-item {
  padding: 2px 6px;
  background-color: var(--bg-secondary);
  border-radius: 4px;
}

.tag-item text {
  font-size: 11px;
  color: var(--text-secondary);
}

.loading-more, .no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  gap: 8px;
}

.loading-spinner.small {
  width: 24px;
  height: 24px;
  margin-bottom: 0;
}

.loading-more-text, .no-more-text {
  font-size: 14px;
  color: var(--text-tertiary);
}

.voice-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.voice-modal {
  width: 280px;
  background-color: #ffffff;
  border-radius: 20px;
  padding: 40px 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.voice-animation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 24px;
  height: 80px;
}

.voice-wave {
  width: 6px;
  height: 40px;
  background-color: var(--color-success);
  border-radius: 3px;
  animation: wave 1s ease-in-out infinite;
}

.voice-wave:nth-child(1) {
  animation-delay: 0;
}

.voice-wave:nth-child(2) {
  animation-delay: 0.2s;
}

.voice-wave:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes wave {
  0%, 100% {
    height: 10rpx;
  }
  50% {
    height: 40rpx;
  }
}

.voice-tip {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24px;
}

.voice-time {
  font-size: 14px;
}

.voice-stop-btn {
  width: 120px;
}

.btn-secondary {
  height: 44px;
  border-radius: 50%;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-primary);
  border: 2px solid #000000;
}

.voice-float-btn {
  position: fixed;
  right: 20px;
  bottom: 100px;
  width: 56px;
  height: 28px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.32);
  z-index: 100;
}

.voice-float-icon {
  width: 28px;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.card {
  background-color: #ffffff;
}

.font-large .section-title, .font-large .product-name, .font-large .search-placeholder, .font-large .search-btn-text, .font-large .history-text, .font-large .hot-text, .font-large .category-text, .font-large .sort-text, .font-large .sort-option-text {
  font-size: 18px;
}

.font-large .empty-title, .font-large .voice-tip {
  font-size: 20px;
}

.font-large .empty-desc, .font-large .count-text, .font-large .loading-text, .font-large .loading-more-text, .font-large .no-more-text {
  font-size: 16px;
}

.font-extra-large .section-title, .font-extra-large .product-name, .font-extra-large .search-placeholder, .font-extra-large .search-btn-text, .font-extra-large .history-text, .font-extra-large .hot-text, .font-extra-large .category-text, .font-extra-large .sort-text, .font-extra-large .sort-option-text {
  font-size: 20px;
}

.font-extra-large .empty-title, .font-extra-large .voice-tip {
  font-size: 22px;
}

.font-extra-large .empty-desc, .font-extra-large .count-text, .font-extra-large .loading-text, .font-extra-large .loading-more-text, .font-extra-large .no-more-text {
  font-size: 18px;
}

.high-contrast .section-title, .high-contrast .product-name, .high-contrast .search-placeholder, .high-contrast .search-btn-text {
  color: #000000;
}

.high-contrast .card {
  background-color: #ffffff;
}

.high-contrast .search-box {
  background-color: #ffffff;
}

.dark-mode .search-page {
  background-color: var(--bg-dark);
}

.dark-mode .nav-bar {
  background-color: var(--color-dark);
}

.dark-mode .search-box {
  background-color: var(--color-dark);
}

.dark-mode .search-input {
  color: #ffffff;
}

.dark-mode .search-placeholder {
  color: var(--text-tertiary);
}

.dark-mode .search-btn-text {
  color: var(--color-primary);
}

.dark-mode .section-title {
  color: #ffffff;
}

.dark-mode .history-item, .dark-mode .hot-item {
  background-color: var(--color-dark);
  border-color: var(--color-dark);
}

.dark-mode .history-text, .dark-mode .hot-text {
  color: var(--text-disabled);
}

.dark-mode .empty-title {
  color: #ffffff;
}

.dark-mode .empty-desc, .dark-mode .loading-text {
  color: var(--text-disabled);
}

.dark-mode .filter-bar {
  background-color: var(--color-dark);
  border-bottom-color: var(--color-dark);
}

.dark-mode .category-item {
  background-color: var(--color-dark);
}

.dark-mode .category-text {
  color: var(--text-disabled);
}

.dark-mode .sort-btn {
  background-color: var(--color-dark);
}

.dark-mode .sort-text {
  color: var(--text-disabled);
}

.dark-mode .sort-options {
  background-color: var(--color-dark);
}

.dark-mode .sort-option-text {
  color: #ffffff;
}

.dark-mode .count-text {
  color: var(--text-tertiary);
}

.dark-mode .product-item {
  background-color: var(--color-dark);
}

.dark-mode .product-name {
  color: #ffffff;
}

.dark-mode .tag-item {
  background-color: var(--color-dark);
}

.dark-mode .tag-item text {
  color: var(--text-disabled);
}

.dark-mode .no-more-text, .dark-mode .loading-more-text {
  color: var(--text-tertiary);
}
