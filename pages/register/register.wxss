.register-page {
  background-color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.register-content {
  flex: 1;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
}

.brand-section {
  padding: 60rpx 0 48rpx;
  text-align: center;
}

.brand-logo {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.brand-title {
  display: block;
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.brand-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-primary);
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.input-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.input-prefix {
  font-size: 28rpx;
  color: #333333;
  margin-right: 16rpx;
  padding-right: 16rpx;
  border-right: 2rpx solid var(--border-light-2);
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 100%;
}

.code-box {
  padding-right: 0;
}

.code-input {
  flex: 1;
}

.code-btn {
  height: 100%;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background-color: transparent;
  border-left: 2rpx solid var(--border-light-2);
  border-radius: 0 12rpx 12rpx 0;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-btn::after {
  border: none;
}

.code-btn.disabled {
  color: #cccccc;
}

.agree-section {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 16rpx 0 32rpx;
}

.agree-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border-light-2);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: white;
}

.agree-checkbox.checked {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.agree-text {
  color: #666666;
  font-size: 24rpx;
}

.agree-link {
  color: var(--color-primary);
  font-size: 24rpx;
}

.register-btn {
  width: 100%;
  height: 96rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  margin-bottom: 24rpx;
}

.register-btn::after {
  border: none;
}

.register-btn:active {
  background-color: #e55a8a;
}

.register-btn.disabled {
  background-color: var(--border-light-2);
  color: #999999;
  pointer-events: none;
}

.login-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 60rpx;
}

.login-link-text {
  font-size: 26rpx;
  color: #999999;
}

.login-link-btn {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-left: 8rpx;
}

.success-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.success-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--color-success);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.success-icon {
  font-size: 80rpx;
  color: white;
  font-weight: 500;
}

.success-title {
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 60rpx;
  max-width: 400rpx;
}

.success-btn {
  width: 400rpx;
  height: 88rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.success-btn:active {
  background-color: #e55a8a;
}
