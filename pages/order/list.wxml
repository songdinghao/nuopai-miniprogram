<!-- pages/order/list.wxml - 订单列表页面 -->
<view class="order-list-page {{fontSize === 'large' ? 'font-large' : fontSize === 'xlarge' ? 'font-xlarge' : ''}}" style="font-size: {{fontSize === 'normal' ? '16px' : fontSize === 'large' ? '18px' : '20px'}}">

  <!-- 订单状态标签 -->
  <scroll-view class="tabs-scroll" scroll-x="true" show-scrollbar="false">
    <view class="tabs-list">
      <view wx:for="{{statusList}}" wx:key="key" class="tab-item {{currentStatus === item.key ? 'active' : ''}}" bindtap="onStatusTap" data-status="{{item.key}}">
        <text class="tab-text">{{item.name}}</text>
        <view wx:if="{{currentStatus === item.key}}" class="tab-indicator"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="order-skeleton">
      <view class="skeleton-line w60"></view>
      <view class="skeleton-block"></view>
      <view class="skeleton-line w80"></view>
      <view class="skeleton-line w40"></view>
    </view>
  </view>

  <!-- 加载失败 -->
  <empty-state wx:if="{{!loading && loadError}}" title="加载失败" description="请检查网络后重试" type="network" buttonText="重新加载" bindaction="retryLoadList"></empty-state>

  <view wx:if="{{!loading && !loadError && orderList.length > 0}}" class="order-list">
    <view wx:for="{{orderList}}" wx:key="id" class="order-item" bindtap="onOrderDetail" data-id="{{item.id}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-shop">
          <text class="shop-icon">🏪</text>
          <text class="shop-name">诺派永生花旗舰店</text>
        </view>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="order-goods">
        <view wx:for="{{item.goods}}" wx:for-item="goods" wx:key="id" class="goods-item">
          <image class="goods-image" mode="aspectFill" src="{{goods.image}}" />
      <view class="goods-info">
        <text class="goods-name">{{goods.name}}</text>
        <text wx:if="{{goods.spec}}" class="goods-spec">{{goods.spec}}</text>
        <view class="goods-bottom">
          <text class="goods-price">¥{{goods.price}}</text>
          <text class="goods-count">x{{goods.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单底部 -->
  <view class="order-footer">
    <view class="order-info">
      <text class="goods-total">共{{item.totalCount}}件商品</text>
      <text class="order-total">实付：<text class="total-price">¥{{item.totalPrice}}</text></text>
    </view>
    <view class="order-actions">
      <view wx:if="{{item.actions.cancel}}" class="action-btn secondary" catchtap="onCancelOrder" data-id="{{item.id}}">取消订单</view>
      <view wx:if="{{item.actions.pay}}" class="action-btn secondary" catchtap="onPayOrder" data-id="{{item.id}}">去支付</view>
      <view wx:if="{{item.actions.confirm}}" class="action-btn secondary" catchtap="onConfirmOrder" data-id="{{item.id}}">确认收货</view>
      <view wx:if="{{item.actions.review}}" class="action-btn primary" catchtap="onReviewOrder" data-id="{{item.id}}">去评价</view>
      <view wx:if="{{item.actions.afterSale}}" class="action-btn secondary" catchtap="onAfterSale" data-id="{{item.id}}">申请售后</view>
      <view wx:if="{{item.actions.rebuy}}" class="action-btn secondary" catchtap="onReBuy" data-id="{{item.id}}">再次购买</view>
    </view>
  </view>
</view>
</view>

<empty-state wx:else type="order" title="暂无订单" description="去逛逛挑选心仪的商品吧" buttonText="去逛逛" buttonUrl="/pages/index/index" />

<view class="safe-area-bottom"></view>
</view>
