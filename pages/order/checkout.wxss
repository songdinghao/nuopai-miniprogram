.checkout-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.header {
  background-color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  height: 88rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.nav-left, .nav-right {
  width: 100rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.back-btn .icon {
  font-size: 40rpx;
  color: #666666;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-weight: 500;
  font-size: 32rpx;
  color: #333333;
}

.title-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-content {
  flex: 1;
  overflow: hidden;
  padding: 24rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.order-content {
  padding-bottom: 150rpx;
}

.section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.section-header {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.group-buy-badge {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-primary);
  font-weight: 500;
}

.product-group-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-light);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  display: inline-block;
  margin-top: 4rpx;
  align-self: flex-start;
}

.group-buy-info {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: var(--bg-color);
  border-radius: 8rpx;
  border: 1rpx solid var(--border-light);
}

.group-buy-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.group-buy-info-row:first-child {
  padding-top: 0;
}

.group-buy-info-label {
  font-size: 24rpx;
  color: #999999;
}

.group-buy-info-value {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.address-card {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.address-info {
  flex: 1;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-right: 24rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #666666;
}

.address-detail {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.address-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #999999;
  font-size: 28rpx;
  padding: 32rpx 0;
}

.address-arrow {
  font-size: 40rpx;
  color: #cccccc;
  margin-left: 16rpx;
}

.arrow {
  font-size: 40rpx;
  color: #cccccc;
}

.products-list {
  padding-top: 8rpx;
}

.product-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background-color: var(--bg-color);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.product-specs {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.product-quantity {
  font-size: 26rpx;
  color: #999999;
}

.coupon-card {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.coupon-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.coupon-value {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-right: 16rpx;
}

.coupon-name {
  font-size: 28rpx;
  color: #333333;
}

.coupon-empty {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-count {
  color: var(--color-primary);
  font-size: 24rpx;
}

/* 积分抵扣 */
.points-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.points-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.points-balance {
  color: #2D8C7A;
  font-size: 28rpx;
}

.points-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-deduct {
  color: #FF4444;
  font-size: 32rpx;
  font-weight: bold;
}

.price-deduct {
  color: #FF4444;
}

.remark-box {
  position: relative;
}

.remark-input {
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx;
  padding-right: 60rpx;
  background-color: var(--bg-color);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

.remark-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #cccccc;
}

.price-list {
  padding-top: 8rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--bg-color);
}

.price-item:last-child {
  border-bottom: none;
}

.price-item.discount {
  color: var(--color-success);
}

.price-label {
  font-size: 26rpx;
  color: #666666;
}

.price-value {
  font-size: 26rpx;
  color: #333333;
}

.discount .price-value {
  color: var(--color-success);
}

.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
  position: sticky;
  bottom: 0;
  z-index: 100;
}

.total-section {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #333333;
}

.total-price {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.submit-btn {
  padding: 20rpx 48rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.submit-btn:active {
  background-color: var(--color-primary-active);
}

.pay-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.modal-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  padding: 8rpx;
}

.pay-methods {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 0;
}

.pay-method {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--bg-color);
}

.pay-method:last-child {
  border-bottom: none;
}

.pay-method.selected {
  background-color: #fff5f8;
}

.pay-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.pay-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.pay-check {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--border-light-2);
  border-radius: 50%;
}

.pay-method.selected .pay-check {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  position: relative;
}

.pay-method.selected .pay-check::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 8rpx;
  border-left: 3rpx solid white;
  border-bottom: 3rpx solid white;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.modal-bottom {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pay-total {
  display: flex;
  align-items: baseline;
}

.pay-label {
  font-size: 26rpx;
  color: #333333;
}

.pay-price {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.pay-btn {
  padding: 20rpx 48rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.pay-btn:active {
  background-color: var(--color-primary-active);
}

/* ===== 满减优惠 ===== */
.full-reduction-bar {
  background-color: #FFF8E1;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.fr-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.fr-text {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.fr-save {
  font-size: 26rpx;
  color: #FF4444;
  font-weight: bold;
  flex-shrink: 0;
}

.next-threshold-bar {
  background-color: #E8F5E9;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.next-threshold-bar text {
  font-size: 24rpx;
  color: #2D8C7A;
}

/* ===== 字体适配 ===== */
.font-large .product-name {
  font-size: 32rpx;
}
.font-large .product-price {
  font-size: 34rpx;
}
.font-large .submit-btn {
  font-size: 32rpx;
  padding: 24rpx 56rpx;
}
.font-large .total-price {
  font-size: 40rpx;
}
.font-large .pay-price {
  font-size: 40rpx;
}
.font-large .pay-btn {
  font-size: 32rpx;
  padding: 24rpx 56rpx;
}
.font-large .modal-title {
  font-size: 36rpx;
}

.font-extra-large .product-name {
  font-size: 36rpx;
}
.font-extra-large .product-price {
  font-size: 38rpx;
}
.font-extra-large .submit-btn {
  font-size: 36rpx;
  padding: 28rpx 64rpx;
}
.font-extra-large .total-price {
  font-size: 44rpx;
}
.font-extra-large .pay-price {
  font-size: 44rpx;
}
.font-extra-large .pay-btn {
  font-size: 36rpx;
  padding: 28rpx 64rpx;
}
.font-extra-large .modal-title {
  font-size: 40rpx;
}
