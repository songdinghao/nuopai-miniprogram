.order-list-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 加载骨架屏 ===== */
.loading-container {
  padding: 32rpx 24rpx;
}

.order-skeleton {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.skeleton-line.w80 { width: 80%; }
.skeleton-line.w60 { width: 60%; }
.skeleton-line.w40 { width: 40%; }

.skeleton-block {
  height: 160rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.tabs-scroll {
  background-color: #ffffff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.tabs-list {
  display: flex;
  align-items: center;
  white-space: nowrap;
  padding: 0 24rpx;
}

.tab-item {
  position: relative;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-text {
  font-size: 28rpx;
  color: #666666;
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  bottom: 12rpx;
  width: 40rpx;
  height: 6rpx;
  background-color: var(--color-primary);
  border-radius: 3rpx;
}

.order-list {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.order-shop {
  display: flex;
  align-items: center;
}

.shop-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.shop-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.order-status {
  font-size: 26rpx;
}

.order-status.pending {
  color: var(--color-warm);
}

.order-status.paid {
  color: #2196f3;
}

.order-status.shipped {
  color: var(--color-success);
}

.order-status.completed {
  color: #999999;
}

.order-status.cancelled {
  color: #999999;
}

.order-goods {
  padding: 24rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 24rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: var(--border-light);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-spec {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.goods-count {
  font-size: 24rpx;
  color: #999999;
}

.order-footer {
  padding: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.order-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.goods-total {
  font-size: 24rpx;
  color: #999999;
}

.order-total {
  font-size: 24rpx;
  color: #666666;
}

.total-price {
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.2;
}

.action-btn::after {
  border: none;
}

.action-btn.secondary {
  background-color: var(--bg-color);
  color: #666666;
}

.action-btn.primary {
  background: var(--color-primary);
  color: #ffffff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.order-list-page.font-large .tab-text {
  font-size: 32rpx;
}

.order-list-page.font-large .shop-name, .order-list-page.font-large .goods-name {
  font-size: 32rpx;
}

.order-list-page.font-large .order-status, .order-list-page.font-large .goods-price {
  font-size: 30rpx;
}

.order-list-page.font-large .goods-spec, .order-list-page.font-large .goods-total, .order-list-page.font-large .order-total {
  font-size: 28rpx;
}

.order-list-page.font-large .total-price {
  font-size: 36rpx;
}

.order-list-page.font-large .action-btn {
  font-size: 30rpx;
  padding: 20rpx 36rpx;
}

.order-list-page.font-large .empty-text {
  font-size: 34rpx;
}

.order-list-page.font-large .empty-desc {
  font-size: 28rpx;
}

.order-list-page.font-large .empty-btn {
  font-size: 32rpx;
}

.order-list-page.font-xlarge .tab-text {
  font-size: 36rpx;
}

.order-list-page.font-xlarge .shop-name, .order-list-page.font-xlarge .goods-name {
  font-size: 36rpx;
}

.order-list-page.font-xlarge .order-status, .order-list-page.font-xlarge .goods-price {
  font-size: 34rpx;
}

.order-list-page.font-xlarge .goods-spec, .order-list-page.font-xlarge .goods-total, .order-list-page.font-xlarge .order-total {
  font-size: 32rpx;
}

.order-list-page.font-xlarge .total-price {
  font-size: 40rpx;
}

.order-list-page.font-xlarge .action-btn {
  font-size: 34rpx;
  padding: 24rpx 40rpx;
}

.order-list-page.font-xlarge .empty-text {
  font-size: 38rpx;
}

.order-list-page.font-xlarge .empty-desc {
  font-size: 32rpx;
}

.order-list-page.font-xlarge .empty-btn {
  font-size: 36rpx;
}
