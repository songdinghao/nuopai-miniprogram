.order-detail-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ===== 加载/错误状态 ===== */
.loading-container, .error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid var(--border-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text, .error-desc {
  color: #999999;
  font-size: 28rpx;
}

.error-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.error-title {
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.error-action {
  margin-top: 32rpx;
  padding: 20rpx 48rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.status-header {
  background: linear-gradient(135deg, var(--color-primary), var(--color-warm));
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.address-section, .goods-section, .order-info-section, .price-section {
  background-color: #ffffff;
  margin: -20rpx 16rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.goods-section, .order-info-section, .price-section {
  margin: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.title-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.title-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.address-info {
  padding: 8rpx 0;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.receiver-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-right: 20rpx;
}

.receiver-phone {
  font-size: 28rpx;
  color: #666666;
}

.address-detail {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.goods-list {
  padding: 8rpx 0;
}

.goods-item {
  display: flex;
  padding: 16rpx 0;
}

.goods-item:first-child {
  padding-top: 0;
}

.goods-item:last-child {
  padding-bottom: 0;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: var(--border-light);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-spec {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.goods-count {
  font-size: 24rpx;
  color: #999999;
}

.info-list {
  padding: 8rpx 0;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  text-align: right;
}

.price-list {
  padding: 8rpx 0;
}

.price-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-item.total {
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--border-light);
}

.price-label {
  font-size: 26rpx;
  color: #666666;
}

.price-item.total .price-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.price-value {
  font-size: 26rpx;
  color: #333333;
}

.price-value.coupon {
  color: var(--color-primary);
}

.price-value.total {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.bottom-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
}

.action-buttons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.2;
}

.action-btn::after {
  border: none;
}

.action-btn.secondary {
  background-color: var(--bg-color);
  color: #666666;
}

.action-btn.primary {
  background: var(--color-primary);
  color: #ffffff;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.order-detail-page.font-large .status-text {
  font-size: 40rpx;
}

.order-detail-page.font-large .status-desc, .order-detail-page.font-large .receiver-phone, .order-detail-page.font-large .address-detail, .order-detail-page.font-large .goods-spec, .order-detail-page.font-large .goods-count, .order-detail-page.font-large .info-label, .order-detail-page.font-large .info-value, .order-detail-page.font-large .price-label, .order-detail-page.font-large .price-value {
  font-size: 30rpx;
}

.order-detail-page.font-large .title-text, .order-detail-page.font-large .receiver-name, .order-detail-page.font-large .goods-name, .order-detail-page.font-large .goods-price {
  font-size: 32rpx;
}

.order-detail-page.font-large .price-value.total {
  font-size: 40rpx;
}

.order-detail-page.font-large .action-btn {
  font-size: 32rpx;
  padding: 20rpx 40rpx;
}

.order-detail-page.font-xlarge .status-text {
  font-size: 44rpx;
}

.order-detail-page.font-xlarge .status-desc, .order-detail-page.font-xlarge .receiver-phone, .order-detail-page.font-xlarge .address-detail, .order-detail-page.font-xlarge .goods-spec, .order-detail-page.font-xlarge .goods-count, .order-detail-page.font-xlarge .info-label, .order-detail-page.font-xlarge .info-value, .order-detail-page.font-xlarge .price-label, .order-detail-page.font-xlarge .price-value {
  font-size: 34rpx;
}

.order-detail-page.font-xlarge .title-text, .order-detail-page.font-xlarge .receiver-name, .order-detail-page.font-xlarge .goods-name, .order-detail-page.font-xlarge .goods-price {
  font-size: 36rpx;
}

.order-detail-page.font-xlarge .price-value.total {
  font-size: 44rpx;
}

.order-detail-page.font-xlarge .action-btn {
  font-size: 36rpx;
  padding: 24rpx 44rpx;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  color: #dddddd;
}

.empty-title {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 48rpx;
  max-width: 400rpx;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  background: var(--color-primary, #2D8C7A);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 28rpx;
}
