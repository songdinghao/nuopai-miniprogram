.notification-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.top-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 50;
}

.tab-scroll {
  flex: 1;
  white-space: nowrap;
}

.tab-list {
  display: flex;
  gap: 8rpx;
  padding: 20rpx 0;
}

.tab-item {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background-color: var(--bg-secondary);
  position: relative;
  flex-shrink: 0;
}

.tab-item.active {
  background-color: var(--color-primary);
}

.tab-text {
  font-size: 26rpx;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #ffffff;
  font-weight: 500;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: #e74c3c;
  color: white;
  border-radius: 50%;
  min-width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 500;
  padding: 0 6rpx;
}

.mark-all-btn {
  padding: 12rpx 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.mark-all-text {
  font-size: 26rpx;
  color: #999999;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 48rpx;
  padding: 0 60rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background-color: var(--color-primary);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.notification-scroll {
  height: calc(100vh - 100rpx);
}

.notification-list {
  padding: 16rpx 24rpx;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.notification-item:active {
  background-color: #fafafa;
}

.notification-item.unread {
  background-color: var(--color-primary-light);
}

.unread-dot {
  position: absolute;
  top: 20rpx;
  left: 16rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: var(--color-primary);
  border-radius: 50%;
}

.notification-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  background-color: var(--bg-secondary);
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notification-time {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.notification-type {
  margin-bottom: 8rpx;
}

.notification-type text {
  font-size: 22rpx;
  color: var(--color-primary);
  padding: 2rpx 10rpx;
  background-color: rgba(255, 107, 157, 0.08);
  border-radius: 4rpx;
}

.notification-summary {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.delete-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.delete-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.3;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
