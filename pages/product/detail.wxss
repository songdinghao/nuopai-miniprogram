/* ============================================
   商品详情页 - 诺派永生花·雅集美学
   目标用户: 30-60岁家庭主妇
   设计理念: 温暖、优雅、易读、操作清晰
   ============================================ */

.product-detail-page {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ----- 加载 & 错误状态 ----- */
.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid var(--border-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.85s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.error-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.error-title {
  font-size: 36rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.error-desc {
  color: var(--text-tertiary);
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.error-action {
  margin-top: 32rpx;
  padding: 22rpx 56rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: var(--shadow-primary);
}

/* ----- 空状态 ----- */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 34rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 56rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: var(--shadow-primary);
}

/* ----- 顶部导航栏 ----- */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--border-light);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  height: 88rpx;
}

.nav-left,
.nav-right {
  width: 120rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-secondary);
  justify-content: center;
  transition: transform 0.2s;
}

.back-btn:active {
  transform: scale(0.92);
}

.back-btn .icon {
  font-size: 40rpx;
  color: var(--text-primary);
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.nav-right {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  position: relative;
  transition: transform 0.2s;
}

.nav-btn:active {
  transform: scale(0.9);
}

.nav-btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.nav-btn-share {
  background: var(--bg-secondary);
}
.nav-btn-share .nav-btn-icon {
  color: var(--text-secondary);
}

.nav-btn-cart {
  background: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(45, 140, 122, 0.25);
}
.nav-btn-cart .nav-btn-icon {
  color: #fff;
}

.nav-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: var(--color-red);
  color: #fff;
  border-radius: 50%;
  min-width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 500;
  padding: 0 6rpx;
  border: 2rpx solid #fff;
}

/* ----- 商品内容区 ----- */
.product-content {
  padding-bottom: 140rpx;
}

/* ----- 轮播图 ----- */
.swiper-wrapper {
  position: relative;
  z-index: 10;
}

.product-swiper {
  width: 100%;
  height: 680rpx;
  background: #fff;
  position: relative;
  z-index: 2;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--bg-color);
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 渐变遮罩让指示器更清晰 — 移入 swiper-item 内部，避免干扰 swiper 手势识别 */
.swiper-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.3), transparent);
  pointer-events: none;
  z-index: 1;
}

.image-desc {
  position: absolute;
  bottom: 32rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8rpx);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  z-index: 2;
  pointer-events: none;
}

.image-indicator {
  position: absolute;
  bottom: 32rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8rpx);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  pointer-events: none;
  z-index: 2;
}

/* ----- 基础信息卡片 ----- */
.product-basic-info {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 5;
}

/* 价格区域 */
.price-section {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.current-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.price-number {
  font-size: 52rpx;
  color: var(--color-primary);
  font-weight: 600;
  line-height: 1;
  letter-spacing: -1rpx;
}

.original-price {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.discount-badge {
  background: linear-gradient(135deg, var(--color-warm), #A68A4A);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 商品名称 */
.product-name {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

/* 商品描述 */
.product-description {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  border-left: 4rpx solid var(--color-warm);
}

/* 商品标签 */
.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.product-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 销量/评价/库存 */
.sales-rating {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.sales-info,
.rating-info,
.stock-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.sales-label,
.rating-label,
.stock-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.sales-value,
.rating-value,
.stock-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.review-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  text-align: center;
  margin-top: 4rpx;
}

/* ----- 公共卡片样式 ----- */
.section-card {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--color-warm), var(--color-primary));
  margin-right: 14rpx;
  border-radius: 3rpx;
}

.title-text {
  letter-spacing: 0.5rpx;
}

/* ----- 促销活动 ----- */
.promotions-section {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.promotions-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.promotion-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: var(--bg-color);
  border-radius: 14rpx;
  border-left: 5rpx solid var(--color-warm);
  transition: transform 0.15s;
}

.promotion-item:active {
  transform: scale(0.985);
}

.promotion-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.promotion-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.promotion-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.promotion-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.promotion-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* ----- 拼团区块 ----- */
.group-buy-section {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.group-buy-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.group-buy-tag {
  background: linear-gradient(135deg, #C9A96E, #A68A4A);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  margin-right: 14rpx;
}

.group-buy-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.group-buy-types {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.group-buy-type {
  background: linear-gradient(135deg, rgba(45, 140, 122, 0.05), rgba(201, 169, 110, 0.08));
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-light);
  transition: transform 0.15s;
}

.group-buy-type:active {
  transform: scale(0.985);
}

.group-buy-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.group-buy-price-label {
  font-size: 24rpx;
  color: var(--color-warm);
  font-weight: 500;
}

.group-buy-price {
  font-size: 40rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.group-buy-original {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.group-buy-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.group-buy-social {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
}

.social-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.social-arrow {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ----- 规格选择 ----- */
.sku-section {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.sku-option {
  margin-bottom: 28rpx;
}

.sku-option:last-child {
  margin-bottom: 0;
}

.option-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.option-values {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-value {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 28rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  min-width: 140rpx;
  transition: all 0.2s ease;
}

.option-value:active {
  transform: scale(0.95);
}

.option-value.selected {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  box-shadow: 0 2rpx 12rpx rgba(45, 140, 122, 0.15);
}

.value-text {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.option-value.selected .value-text {
  color: var(--color-primary);
  font-weight: 500;
}

.value-price {
  font-size: 22rpx;
  color: var(--color-warm);
}

.current-sku-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--border-light);
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.info-price {
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
}

/* ----- 数量选择 ----- */
.quantity-section {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.quantity-selector {
  display: flex;
  align-items: center;
}

.quantity-btn {
  width: 76rpx;
  height: 76rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-primary);
  font-weight: 500;
  transition: all 0.15s;
}

.quantity-btn:active {
  background: var(--bg-secondary);
  transform: scale(0.92);
}

.quantity-btn.disabled {
  background: var(--border-light);
  color: var(--text-disabled);
}

.quantity-btn.disabled:active {
  transform: none;
}

.quantity-input {
  width: 140rpx;
  height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: var(--bg-color);
  margin: 0 16rpx;
  border-radius: 12rpx;
  border: none;
}

.quantity-hint {
  font-size: 24rpx;
  color: var(--color-red);
  margin-top: 14rpx;
  display: block;
  padding-left: 32rpx;
}

/* ----- 详情选项卡 ----- */
.detail-tabs {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  position: sticky;
  top: 88rpx;
  z-index: 50;
}

.tabs-header {
  display: flex;
  background: #fff;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 20rpx;
  position: relative;
  transition: color 0.25s;
}

.tab-item.active {
  color: var(--color-primary);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 5rpx;
  background: linear-gradient(90deg, var(--color-warm), var(--color-primary));
  border-radius: 3rpx;
  transition: width 0.25s ease;
}

.tab-icon {
  font-size: 30rpx;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: color 0.25s;
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 500;
}

.tabs-content {
  min-height: 300rpx;
}

.tab-pane {
  padding: 28rpx;
}

/* 详情内容 */
.detail-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.detail-item {
  display: flex;
  align-items: flex-start;
}

.item-label {
  font-size: 28rpx;
  color: var(--text-tertiary);
  width: 170rpx;
  flex-shrink: 0;
}

.item-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.item-value.features {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.feature-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding-left: 16rpx;
  position: relative;
}

.feature-item::before {
  content: '·';
  position: absolute;
  left: 0;
  color: var(--color-warm);
  font-weight: 700;
}

.detail-images {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.detail-image {
  width: 100%;
  border-radius: 12rpx;
}

/* 规格参数 */
.params-row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.params-row:last-child {
  border-bottom: none;
}

.params-label {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.params-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 用户评价 */
.reviews-summary {
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(45, 140, 122, 0.04), rgba(201, 169, 110, 0.06));
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}

.rating-overall {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.rating-score {
  font-size: 56rpx;
  color: var(--color-primary);
  font-weight: 600;
  line-height: 1;
}

.rating-star {
  font-size: 30rpx;
  margin: 10rpx 0;
}

.rating-count {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.rating-distribution {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.rating-item {
  display: flex;
  align-items: center;
}

.rating-label {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.rating-bar {
  flex: 1;
  height: 14rpx;
  background: var(--border-light);
  border-radius: 7rpx;
  margin: 0 14rpx;
  overflow: hidden;
}

.rating-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-warm), var(--color-primary));
  border-radius: 7rpx;
  transition: width 0.5s ease;
}

.rating-percent {
  width: 64rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.review-item {
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-light);
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg-secondary);
  margin-right: 18rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.review-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.review-rating {
  font-size: 26rpx;
  flex-shrink: 0;
}

.review-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 18rpx;
}

.review-images {
  display: flex;
  gap: 14rpx;
}

.review-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--bg-secondary);
}

/* 常见问题 */
.qa-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.qa-item {
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-light);
}

.qa-question {
  margin-bottom: 14rpx;
}

.question-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.qa-answer {
  padding-left: 28rpx;
  border-left: 4rpx solid var(--color-warm);
}

.answer-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* ----- 相关推荐 ----- */
.related-products {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.related-list {
  width: 100%;
}

.related-items {
  display: flex;
  gap: 18rpx;
  padding: 8rpx 0;
}

.related-item {
  width: 220rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-color);
  border-radius: 16rpx;
  overflow: hidden;
  transition: transform 0.15s;
}

.related-item:active {
  transform: scale(0.96);
}

.related-image {
  width: 220rpx;
  height: 220rpx;
  background: var(--bg-secondary);
}

.related-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.related-name {
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.related-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
  gap: 8rpx;
}

.related-price .current-price {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.related-price .original-price {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.related-sales {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ----- 配送与售后 ----- */
.delivery-afterSale {
  background: #fff;
  margin: 0 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.info-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ----- 底部操作栏 ----- */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-right: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 10rpx;
  position: relative;
  transition: transform 0.15s;
}

.action-item:active {
  transform: scale(0.9);
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.cart-badge-small {
  position: absolute;
  top: 0;
  right: 2rpx;
  background: var(--color-red);
  color: #fff;
  border-radius: 50%;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 500;
  border: 2rpx solid #fff;
}

.action-right {
  flex: 1;
  display: flex;
  gap: 14rpx;
}

.add-to-cart-btn,
.group-buy-btn,
.buy-now-btn {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  transition: transform 0.15s, opacity 0.15s;
}

.add-to-cart-btn:active,
.group-buy-btn:active,
.buy-now-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.add-to-cart-btn {
  background: linear-gradient(135deg, var(--color-primary), var(--color-pink-mid));
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(45, 140, 122, 0.25);
}

.group-buy-btn {
  background: linear-gradient(135deg, #CBA34E, #A68A3A);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.3);
}

.buy-now-btn {
  background: linear-gradient(135deg, var(--color-warm), #B8954A);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.3);
}

/* AR 预览按钮 */
.ar-preview-btn {
  position: fixed;
  right: 24rpx;
  bottom: 160rpx;
  background: linear-gradient(135deg, #5B8CB8, #4A7BA5);
  color: #fff;
  padding: 18rpx 28rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(91, 140, 184, 0.3);
  z-index: 99;
  transition: transform 0.15s;
}

.ar-preview-btn:active {
  transform: scale(0.93);
}

.ar-icon {
  font-size: 30rpx;
}

.ar-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 社会证明 ===== */
.social-proof-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sales-count {
  font-size: 24rpx;
  color: #999;
}

.view-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

.stock-warning {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: #FFF5F5;
  border-radius: 10rpx;
}

.stock-warning-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.stock-warning-text {
  font-size: 24rpx;
  color: #FF4444;
  font-weight: 600;
}

.hot-bar-wrapper {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hot-bar {
  flex: 1;
  height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  overflow: hidden;
}

.hot-bar-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #4CAF50, #FF9800, #FF4444);
  transition: width 0.6s ease;
}

.hot-bar-label {
  font-size: 20rpx;
  color: #999;
  flex-shrink: 0;
}

.add-to-cart-btn.disabled,
.buy-now-btn.disabled {
  background: #ccc !important;
  box-shadow: none !important;
  opacity: 0.7;
}

/* ===== 限时促销倒计时 ===== */
.promo-banner {
  background: linear-gradient(135deg, #FF4444, #FF6B6B);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.promo-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.promo-icon {
  font-size: 30rpx;
}

.promo-label {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.promo-right {
  display: flex;
  align-items: center;
}

.promo-countdown-label {
  color: #ffffff;
  font-size: 24rpx;
}

.promo-countdown-blocks {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.promo-cd-block {
  color: #ffffff;
  font-size: 24rpx;
  font-family: 'Courier New', Courier, monospace;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 4rpx;
  padding: 2rpx 6rpx;
  font-weight: 500;
}

.promo-cd-sep {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

/* ===== 字体大小适配 ===== */
.product-detail-page.font-large .product-name { font-size: 38rpx; }
.product-detail-page.font-large .product-description { font-size: 32rpx; }
.product-detail-page.font-large .price-number { font-size: 56rpx; }
.product-detail-page.font-large .tab-text { font-size: 30rpx; }
.product-detail-page.font-large .item-label,
.product-detail-page.font-large .item-value { font-size: 32rpx; }
.product-detail-page.font-large .action-text { font-size: 26rpx; }
.product-detail-page.font-large .add-to-cart-btn,
.product-detail-page.font-large .group-buy-btn,
.product-detail-page.font-large .buy-now-btn { font-size: 32rpx; }

.product-detail-page.font-xlarge .product-name { font-size: 42rpx; }
.product-detail-page.font-xlarge .product-description { font-size: 36rpx; }
.product-detail-page.font-xlarge .price-number { font-size: 60rpx; }
.product-detail-page.font-xlarge .tab-text { font-size: 34rpx; }
.product-detail-page.font-xlarge .item-label,
.product-detail-page.font-xlarge .item-value { font-size: 36rpx; }
.product-detail-page.font-xlarge .action-text { font-size: 30rpx; }
.product-detail-page.font-xlarge .add-to-cart-btn,
.product-detail-page.font-xlarge .group-buy-btn,
.product-detail-page.font-xlarge .buy-now-btn {
  font-size: 36rpx;
  height: 90rpx;
}

