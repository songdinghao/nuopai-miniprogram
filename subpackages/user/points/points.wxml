<!-- pages/user/points/points.wxml - 积分页面 -->
<view class="points-page">
  <!-- 积分总数卡片 -->
  <view class="points-header">
    <view class="points-card">
      <text class="points-label">我的积分</text>
      <view class="points-number">
        <text class="points-value">{{totalPoints}}</text>
      </view>
      <view class="points-rules" bindtap="onRulesTap">
        <image class="rules-icon" src="/assets/icons/info.png" />
    <text class="rules-text">积分规则</text>
  </view>
</view>

<view class="points-summary">
  <view class="summary-item">
    <text class="summary-value">{{totalPointsDisplay}}</text>
    <text class="summary-label">可抵扣金额</text>
  </view>
  <view class="summary-divider"></view>
  <view class="summary-item">
    <text class="summary-value">{{earnCount}}</text>
    <text class="summary-label">本月获得</text>
  </view>
  <view class="summary-divider"></view>
  <view class="summary-item">
    <text class="summary-value">{{spendCount}}</text>
    <text class="summary-label">本月使用</text>
  </view>
</view>
</view>

<!-- 积分兑换商城 -->
<view class="exchange-section">
  <view class="section-header">
    <text class="section-title">积分兑换</text>
    <text class="section-sub">好物兑换</text>
  </view>
  <scroll-view scroll-x class="exchange-scroll">
    <view class="exchange-list">
      <block wx:for="{{exchangeItems}}" wx:key="id">
        <view class="exchange-item" bindtap="onExchangeTap" data-item="{{item}}">
          <text class="exchange-icon">{{item.icon}}</text>
          <text class="exchange-name">{{item.name}}</text>
          <text class="exchange-desc">{{item.desc}}</text>
          <view class="exchange-points">
            <text class="exchange-points-value">{{item.points}}</text>
            <text class="exchange-points-label">积分</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>

<!-- 加载中 -->
<view wx:if="{{loading && page === 1}}" class="loading-state">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 非加载态 -->
<block wx:else>
  <!-- 积分明细标题 -->
  <view class="detail-header">
    <text class="detail-title">积分明细</text>
  </view>

  <view wx:if="{{pointsList.length === 0 && emptyState.show}}" class="empty-state-wrap">
    <empty-state description="{{emptyState.desc}}" icon="⭐" title="{{emptyState.title}}" type="default"></empty-state>
  </view>

  <view wx:if="{{pointsList.length > 0}}" class="detail-list">
  <block wx:for="{{pointsList}}" wx:key="id">
    <view class="detail-item">
      <view class="detail-left">
        <view class="detail-source-icon {{item.type === 'earn' ? 'earn' : 'spend'}}">
          <text class="source-emoji">{{item.type === 'earn' ? '+' : '-'}}</text>
        </view>
        <view class="detail-info">
          <text class="detail-source">{{item.source}}</text>
          <text class="detail-time">{{item.time}}</text>
          <text wx:if="{{item.orderNo}}" class="detail-orderno">订单号：{{item.orderNo}}</text>
        </view>
      </view>
      <text class="detail-points {{item.type === 'earn' ? 'positive' : 'negative'}}">
        {{item.type === 'earn' ? '+' : ''}}{{item.points}}
      </text>
    </view>
  </block>

  <!-- 加载更多 -->
  <loading-more hasMore="{{hasMore}}" status="{{loading ? 'loading' : (hasMore ? 'loading' : 'no-more')}}"></loading-more>

  <view class="safe-area-bottom"></view>
</view>
</block>

<view wx:if="{{showRulesModal}}" class="rules-mask" bindtap="onCloseRulesModal">
  <view class="rules-modal" catchtap="onModalTap">
    <view class="rules-modal-header">
      <text class="rules-modal-title">积分规则</text>
      <view class="rules-close" bindtap="onCloseRulesModal">
        <text class="rules-close-text">✕</text>
      </view>
    </view>
    <scroll-view scroll-y class="rules-modal-body">
      <view class="rules-section">
        <text class="rules-section-title">获取积分</text>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">新用户注册：一次性奖励 <text class="rules-highlight">100</text> 积分</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">每日签到：每日奖励 <text class="rules-highlight">5</text> 积分，连续签到7天额外奖励50积分，30天额外奖励300积分</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">购物返积分：每消费 <text class="rules-highlight">1</text> 元获得 <text class="rules-highlight">1</text> 积分（会员等级越高倍数越多）</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">评价商品：每条有效评价奖励 <text class="rules-highlight">50</text> 积分</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">邀请好友：成功邀请一位好友注册奖励 <text class="rules-highlight">50</text> 积分</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">分享商品：每次分享奖励 <text class="rules-highlight">10</text> 积分（每日上限3次）</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">生日奖励：生日当月可领取 <text class="rules-highlight">100</text> 积分</text>
        </view>
      </view>

      <view class="rules-section">
        <text class="rules-section-title">消耗积分</text>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">积分可抵扣现金：<text class="rules-highlight">100</text> 积分 = <text class="rules-highlight">1</text> 元</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">积分抵扣最高不超过订单金额的 <text class="rules-highlight">20%</text></text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">可在结算时选择使用积分抵扣</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">积分可兑换优惠券和积分商城商品</text>
        </view>
      </view>

      <view class="rules-section">
        <text class="rules-section-title">有效期</text>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">积分有效期为 <text class="rules-highlight">12</text> 个月，过期自动清零</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">积分不可转让、不可兑现</text>
        </view>
      </view>

      <view class="rules-section">
        <text class="rules-section-title">会员加速</text>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">银卡会员：购物积分 <text class="rules-highlight">1.2</text> 倍</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">金卡会员：购物积分 <text class="rules-highlight">1.5</text> 倍</text>
        </view>
        <view class="rules-item">
          <text class="rules-item-dot">•</text>
          <text class="rules-item-text">钻石会员：购物积分 <text class="rules-highlight">2</text> 倍</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
</view>
