.coupon-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
               "Hiragino Sans GB", "Microsoft YaHei", Helvetica,
               Arial, sans-serif;
  padding-bottom: 80px;
}

.tab-bar {
  display: flex;
  background-color: #ffffff;
  padding: 0 16px;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 0;
  position: relative;
}

.tab-text {
  font-size: 16px;
  color: var(--text-secondary);
  font-weight: 400;
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 40px;
  height: 3px;
  background-color: var(--color-primary);
  border-radius: 2px;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--bg-hover);
  border-top: 3px solid var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 16px;
  color: var(--text-tertiary);
}

.empty-state-wrap {
  padding-top: 120px;
}

.coupon-scroll {
  height: calc(100vh - 88px - 50px - 60px);
}

.coupon-list {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.coupon-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  position: relative;
}

.coupon-card::before {
  content: '';
  position: absolute;
  left: 140px;
  top: -8px;
  width: 16px;
  height: 16px;
  background-color: var(--bg-color);
  border-radius: 50%;
  z-index: 1;
}

.coupon-card::after {
  content: '';
  position: absolute;
  left: 140px;
  bottom: -8px;
  width: 16px;
  height: 16px;
  background-color: var(--bg-color);
  border-radius: 50%;
  z-index: 1;
}

.coupon-left {
  width: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-pink-mid));
  padding: 20px 12px;
}

.coupon-symbol {
  font-size: 20px;
  font-weight: 600;
  color: #ffffff;
  margin-top: 8px;
}

.coupon-amount {
  font-size: 44px;
  font-weight: 500;
  color: #ffffff;
}

.coupon-right {
  flex: 1;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: relative;
}

.coupon-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--text-primary);
}

.coupon-condition {
  font-size: 15px;
  color: var(--color-primary);
  font-weight: 500;
}

.coupon-desc {
  font-size: 13px;
  color: var(--text-tertiary);
}

.coupon-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4px;
}

.coupon-endtime {
  font-size: 12px;
  color: var(--text-tertiary);
}

.coupon-usedtime {
  font-size: 12px;
  color: var(--color-success);
}

.coupon-action {
  padding: 6px 16px;
  background-color: var(--color-primary);
  border-radius: 16px;
}

.action-text {
  font-size: 13px;
  color: #ffffff;
  font-weight: 500;
}

.coupon-action.disabled {
  background-color: var(--border-color);
}

.coupon-action.disabled .action-text {
  color: var(--text-tertiary);
}

.coupon-card.expired .coupon-left {
  background: var(--text-disabled);
}

.coupon-card.expired .coupon-title {
  color: var(--text-tertiary);
}

.coupon-card.expired .coupon-condition {
  color: var(--text-tertiary);
}

.expired-text {
  color: var(--color-red) !important;
}

.claim-entry {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16px;
  background-color: #ffffff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
  gap: 10px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
}

.claim-icon {
  width: 24px;
  height: 24px;
}

.claim-text {
  flex: 1;
  font-size: 16px;
  font-weight: 500;
  color: var(--color-primary);
}

.claim-arrow {
  width: 16px;
  height: 16px;
  opacity: 0.4;
}

.claim-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.claim-modal {
  width: 100%;
  max-height: 70vh;
  background-color: #ffffff;
  border-radius: 20px 20px 0 0;
  display: flex;
  flex-direction: column;
}

.claim-modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 16px;
  position: relative;
  border-bottom: 1px solid var(--border-light);
}

.claim-modal-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
}

.claim-close {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.claim-close-text {
  font-size: 20px;
  color: var(--text-tertiary);
}

.claim-modal-body {
  padding: 16px;
  max-height: calc(70vh - 60px);
}

.claim-item {
  display: flex;
  background-color: var(--bg-color);
  border-radius: 12px;
  margin-bottom: 12px;
  overflow: hidden;
  border: 1px solid var(--border-light);
}

.claim-item-left {
  width: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-pink-mid));
  padding: 16px 8px;
}

.claim-item-value {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.claim-value-amount {
  font-size: 28px;
  font-weight: 500;
  color: #ffffff;
}

.claim-value-condition {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4px;
}

.claim-item-right {
  flex: 1;
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
}

.claim-item-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-primary);
}

.claim-item-desc {
  font-size: 12px;
  color: var(--text-tertiary);
}

.claim-btn {
  margin-top: 4px;
  padding: 4px 16px;
  font-size: 13px;
  color: #ffffff;
  background-color: var(--color-primary);
  border-radius: 16px;
  text-align: center;
  line-height: 2;
}

.claim-btn.claimed {
  background-color: var(--border-color);
  color: var(--text-tertiary);
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.font-large .tab-text {
  font-size: 18px;
}

.font-large .coupon-title {
  font-size: 18px;
}

.font-large .coupon-condition {
  font-size: 17px;
}

.font-large .coupon-desc {
  font-size: 15px;
}

.font-large .claim-text {
  font-size: 18px;
}

.font-extra-large .tab-text {
  font-size: 20px;
}

.font-extra-large .coupon-title {
  font-size: 20px;
}

.font-extra-large .coupon-condition {
  font-size: 19px;
}

.font-extra-large .coupon-desc {
  font-size: 17px;
}

.font-extra-large .claim-text {
  font-size: 20px;
}

.dark-mode .coupon-page {
  background-color: var(--bg-dark);
}

.dark-mode .tab-bar {
  background-color: var(--color-dark);
}

.dark-mode .tab-text {
  color: var(--text-tertiary);
}

.dark-mode .tab-item.active .tab-text {
  color: var(--color-primary);
}

.dark-mode .coupon-card {
  background-color: var(--color-dark);
}

.dark-mode .coupon-title {
  color: #ffffff;
}

.dark-mode .coupon-desc {
  color: var(--text-tertiary);
}

.dark-mode .coupon-endtime {
  color: var(--text-tertiary);
}

.dark-mode .claim-entry {
  background-color: var(--color-dark);
}

.dark-mode .claim-modal {
  background-color: var(--color-dark);
}

.dark-mode .claim-modal-title {
  color: #ffffff;
}

.dark-mode .claim-item {
  background-color: #3a3a3a;
  border-color: #4a4a4a;
}

.dark-mode .claim-item-name {
  color: #ffffff;
}
