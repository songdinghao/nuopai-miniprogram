.result-page {
  background-color: var(--bg-color);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
               "Hiragino Sans GB", "Microsoft YaHei", Helvetica,
               Arial, sans-serif;
}

.result-header {
  height: 88px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.header-back {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 20px;
  height: 20px;
}

.header-keyword {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  background-color: var(--bg-secondary);
  border-radius: 24px;
  padding: 8px 16px;
}

.keyword-icon {
  width: 16px;
  height: 16px;
  opacity: 0.5;
}

.keyword-text {
  font-size: 16px;
  color: var(--color-primary);
  font-weight: 500;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background-color: #ffffff;
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 50;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 10px;
}

.category-item {
  padding: 8px 16px;
  background-color: var(--bg-secondary);
  border-radius: 20px;
}

.category-item.active {
  background-color: var(--color-primary);
}

.category-item.active .category-text {
  color: #ffffff;
  font-weight: 500;
}

.category-text {
  font-size: 14px;
  color: var(--text-secondary);
}

.sort-dropdown {
  position: relative;
  flex-shrink: 0;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 12px;
  background-color: var(--bg-secondary);
  border-radius: 16px;
}

.sort-text {
  font-size: 14px;
  color: var(--text-secondary);
}

.sort-icon {
  width: 12px;
  height: 12px;
  opacity: 0.5;
}

.sort-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.sort-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.sort-options {
  position: absolute;
  top: 140px;
  right: 16px;
  background-color: #ffffff;
  border-radius: 12px;
  padding: 8px 0;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.16);
  min-width: 200px;
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  gap: 12px;
}

.sort-option.active .sort-option-text {
  color: var(--color-primary);
  font-weight: 500;
}

.sort-option-text {
  font-size: 15px;
  color: var(--text-primary);
}

.check-icon {
  width: 18px;
  height: 18px;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--bg-hover);
  border-top: 3px solid var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 16px;
  color: var(--text-tertiary);
}

.empty-state-wrap {
  padding-top: 120px;
}

.product-section {
  padding: 0 16px 40px;
}

.result-count {
  padding: 12px 4px;
}

.count-text {
  font-size: 14px;
  color: var(--text-tertiary);
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.product-card {
  background-color: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.product-card:active {
  opacity: 0.85;
}

.product-image {
  width: 100%;
  height: 340rpx;
  display: block;
}

.product-info {
  padding: 12px;
}

.product-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8px;
}

.product-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.tag-item {
  padding: 2px 8px;
  background-color: var(--color-primary-light);
  border-radius: 4px;
  font-size: 11px;
  color: var(--color-primary);
}

.product-price {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 4px;
}

.current-price {
  font-size: 18px;
  font-weight: 600;
  color: var(--color-primary);
}

.original-price {
  font-size: 13px;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.sales-text {
  font-size: 12px;
  color: var(--text-tertiary);
}

.load-more-section {
  padding: 16px 0;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.font-large .keyword-text {
  font-size: 18px;
}

.font-large .category-text {
  font-size: 16px;
}

.font-large .sort-text {
  font-size: 16px;
}

.font-large .product-name {
  font-size: 17px;
}

.font-large .current-price {
  font-size: 20px;
}

.font-large .count-text {
  font-size: 16px;
}

.font-large .sales-text {
  font-size: 14px;
}

.font-extra-large .keyword-text {
  font-size: 20px;
}

.font-extra-large .category-text {
  font-size: 18px;
}

.font-extra-large .sort-text {
  font-size: 18px;
}

.font-extra-large .product-name {
  font-size: 19px;
}

.font-extra-large .current-price {
  font-size: 22px;
}

.font-extra-large .count-text {
  font-size: 18px;
}

.font-extra-large .sales-text {
  font-size: 16px;
}

.dark-mode .result-page {
  background-color: var(--bg-dark);
}

.dark-mode .result-header {
  background-color: var(--color-dark);
}

.dark-mode .header-keyword {
  background-color: var(--color-dark);
}

.dark-mode .keyword-text {
  color: var(--color-primary);
}

.dark-mode .filter-bar {
  background-color: var(--color-dark);
  border-bottom-color: var(--color-dark);
}

.dark-mode .category-item {
  background-color: var(--color-dark);
}

.dark-mode .category-text {
  color: var(--text-disabled);
}

.dark-mode .sort-btn {
  background-color: var(--color-dark);
}

.dark-mode .sort-text {
  color: var(--text-disabled);
}

.dark-mode .sort-options {
  background-color: var(--color-dark);
}

.dark-mode .sort-option-text {
  color: #ffffff;
}

.dark-mode .count-text {
  color: var(--text-tertiary);
}

.dark-mode .product-card {
  background-color: var(--color-dark);
}

.dark-mode .product-name {
  color: #ffffff;
}

.dark-mode .sales-text {
  color: var(--text-tertiary);
}
