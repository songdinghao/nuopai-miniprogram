page {
  --color-primary: #2d8c7a;
  --color-primary-active: #1a6b5c;
  --color-primary-light: #e8f5e9;
  --color-primary-disabled: #a8d5ba;
  --color-warm: #c9a96e;
  --color-success: #4caf50;
  --color-red: #e25a4a;
  --color-blue: #5b8cb8;
  --color-orange: #d4956a;
  --color-wechat-green: #07c160;
  --color-pink-mid: #5baf9e;
  --color-pink-deep: #248c7a;
  --text-primary: #3D3835;
  --text-secondary: #6B6560;
  --text-tertiary: #9C9690;
  --text-disabled: #C8C0B8;
  --border-color: #e0d6c8;
  --border-light: #EDE4D8;
  --border-light-2: #D8CFC0;
  --bg-color: #f7f5f0;
  --bg-secondary: #EDE8DC;
  --bg-hover: #E8E0D4;
  --card-bg: #FFFFFF;
  --color-dark: #3d3835;
  --bg-dark: #1A1A1A;
  --bg-card-dark: #2A2A2A;
  --font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", Helvetica, Arial, sans-serif;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-pill: 40rpx;
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.14);
  --shadow-primary: 0 4px 16px rgba(45, 140, 122, 0.25);
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  font-family: var(--font-family);
  color: var(--text-primary);
  background: var(--bg-color);
  font-size: 15px;
  line-height: 1.6;
  box-sizing: border-box;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 80px;
  height: 48px;
  padding: 0 32px;
  border: none;
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  transition: opacity 0.2s;
  box-sizing: border-box;
  position: relative;
}

.btn::after {
  content: '';
  position: absolute;
  top: -6px;
  left: -6px;
  right: -6px;
  bottom: -6px;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  background: var(--color-primary-active);
}

.btn-confirm {
  background: var(--color-success);
  color: #ffffff;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn-secondary:active {
  background: var(--bg-secondary);
}

.btn-text {
  background: transparent;
  color: var(--color-primary);
  min-width: auto;
  padding: 0 8px;
  height: 40px;
}

.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.btn-small {
  height: 32px;
  padding: 0 16px;
  font-size: 14px;
  border-radius: 6px;
  min-width: auto;
}

.input {
  display: block;
  width: 100%;
  height: 48px;
  padding: 0 16px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: var(--card-bg);
  color: var(--text-primary);
  font-size: 15px;
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--color-primary);
  outline: none;
}

.input-search {
  height: 44px;
  padding: 0 16px 0 40px;
  border: none;
  border-radius: var(--radius-pill);
  background: var(--bg-secondary);
  font-size: 14px;
}

.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  line-height: 1.4;
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-warm {
  background: #fff3e6;
  color: var(--color-warm);
}

.tag-success {
  background: #e8f5e9;
  color: var(--color-success);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px var(--spacing-md);
}

.empty-icon {
  width: 120px;
  height: 120px;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  font-size: 14px;
  color: var(--text-tertiary);
  margin-bottom: var(--spacing-lg);
  text-align: center;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--spacing-md);
}

.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-price {
  color: var(--color-primary);
  font-weight: 600;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-2lines {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.font-bold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

.p-sm {
  padding: var(--spacing-sm);
}

.p-md {
  padding: var(--spacing-md);
}

.p-lg {
  padding: var(--spacing-lg);
}

.ph-sm {
  padding-left: var(--spacing-sm);
  padding-right: var(--spacing-sm);
}

.ph-md {
  padding-left: var(--spacing-md);
  padding-right: var(--spacing-md);
}

.ph-lg {
  padding-left: var(--spacing-lg);
  padding-right: var(--spacing-lg);
}

.pv-sm {
  padding-top: var(--spacing-sm);
  padding-bottom: var(--spacing-sm);
}

.pv-md {
  padding-top: var(--spacing-md);
  padding-bottom: var(--spacing-md);
}

.pv-lg {
  padding-top: var(--spacing-lg);
  padding-bottom: var(--spacing-lg);
}

.gap-sm {
  gap: var(--spacing-sm);
}

.gap-md {
  gap: var(--spacing-md);
}

.gap-lg {
  gap: var(--spacing-lg);
}

.mt-sm {
  margin-top: var(--spacing-sm);
}

.mt-md {
  margin-top: var(--spacing-md);
}

.mt-lg {
  margin-top: var(--spacing-lg);
}

.mb-sm {
  margin-bottom: var(--spacing-sm);
}

.mb-md {
  margin-bottom: var(--spacing-md);
}

.mb-lg {
  margin-bottom: var(--spacing-lg);
}

.radius-sm {
  border-radius: var(--radius-sm);
}

.radius-md {
  border-radius: var(--radius-md);
}

.radius-lg {
  border-radius: var(--radius-lg);
}

.radius-xl {
  border-radius: var(--radius-xl);
}

.radius-full {
  border-radius: 50%;
}

.page-padding {
  padding: 0 var(--spacing-md);
}

.section-gap {
  margin-top: var(--spacing-lg);
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.page-container {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

image {
  background-color: var(--bg-secondary);
}

.dark-mode {
  background: var(--bg-dark);
  color: #d8cfc0;
}

.dark-mode .card {
  background: var(--bg-card-dark);
  border-color: #3a3a3a;
}

.dark-mode .btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.dark-mode .btn-secondary {
  background: var(--bg-card-dark);
  color: #d8cfc0;
  border-color: #3a3a3a;
}

.dark-mode .input {
  background: var(--bg-card-dark);
  color: #d8cfc0;
  border-color: #3a3a3a;
}

.dark-mode .tag-primary {
  background: rgba(45, 140, 122, 0.2);
  color: #5baf9e;
}

.dark-mode .tag-warm {
  background: rgba(201, 169, 110, 0.2);
  color: #d4b87a;
}

.dark-mode .empty-text {
  color: #8a8580;
}

.dark-mode .text-primary {
  color: #d8cfc0;
}

.dark-mode .text-secondary {
  color: #9c9690;
}

.font-large {
  font-size: 17px;
}

.font-large .btn {
  font-size: 17px;
  height: 52px;
}

.font-extra-large {
  font-size: 19px;
}

.font-extra-large .btn {
  font-size: 19px;
  height: 56px;
}
