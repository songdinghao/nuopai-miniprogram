.voice-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.voice-panel {
  width: 520rpx;
  background-color: var(--card-bg);
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.voice-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

.voice-status-area {
  margin-bottom: 32rpx;
}

.voice-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s;
}

.voice-icon.idle {
  background-color: var(--color-primary-light);
  border: 4rpx solid var(--color-primary);
}

.voice-icon.recording {
  background-color: var(--color-primary);
}

.voice-icon.processing {
  background-color: var(--color-warm);
}

.voice-icon.success {
  background-color: var(--color-success);
}

.voice-icon.error {
  background-color: var(--color-red);
}

.icon-mic {
  font-size: 64rpx;
  color: #ffffff;
  position: relative;
  z-index: 2;
}

.voice-icon.idle .icon-mic {
  color: var(--color-primary);
}

.voice-ripple {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 160rpx;
  height: 160rpx;
  margin: -80rpx 0 0 -80rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  animation: ripple 1.5s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.voice-status-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.5;
}

.voice-actions {
  width: 100%;
  margin-bottom: 24rpx;
}

.voice-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.retry-btn {
  background-color: var(--color-primary);
  color: #ffffff;
}

.confirm-btn {
  background-color: var(--color-success);
  color: #ffffff;
}

.stop-btn {
  background-color: var(--card-bg);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.voice-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.5;
}
