.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.privacy-popup {
  width: 85%;
  max-width: 340px;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.privacy-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.privacy-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.privacy-body {
  margin-bottom: 40rpx;
}

.privacy-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.privacy-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
  justify-content: center;
}

.privacy-link {
  font-size: 28rpx;
  color: var(--color-wechat-green);
  text-decoration: underline;
  padding: 4rpx 8rpx;
}

.privacy-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-disabled);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-box.checked {
  background-color: var(--color-wechat-green);
  border-color: var(--color-wechat-green);
}

.checkbox-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

.checkbox-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.privacy-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-agree {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: var(--color-wechat-green);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  border: none;
  padding: 0;
}

.btn-agree::after {
  border: none;
}

.btn-reject {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: transparent;
  color: var(--text-tertiary);
  font-size: 28rpx;
  border: 2rpx solid #DDDDDD;
  border-radius: 44rpx;
  text-align: center;
  padding: 0;
}

.btn-reject::after {
  border: none;
}
