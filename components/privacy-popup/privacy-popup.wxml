<!-- components/privacy-popup/privacy-popup.wxml - 隐私协议弹窗 -->
<view wx:if="{{show}}" class="privacy-mask" catchtouchmove="noop">
  <view class="privacy-popup">
    <view class="privacy-header">
      <text class="privacy-icon">🔒</text>
      <text class="privacy-title">隐私保护指引</text>
    </view>

    <view class="privacy-body">
      <text class="privacy-desc">感谢您使用诺派永生花！在您使用本小程序前，请仔细阅读并同意以下协议：</text>

      <view class="privacy-links">
        <text class="privacy-link" bindtap="onViewServiceAgreement">《用户服务协议》</text>
        <text class="privacy-link" bindtap="onViewPrivacyPolicy">《隐私政策》</text>
      </view>

      <view class="privacy-checkbox" bindtap="onToggleCheck">
        <view class="checkbox-box {{checked ? 'checked' : ''}}">
          <text wx:if="{{checked}}" class="checkbox-icon">✓</text>
        </view>
        <text class="checkbox-label">我已阅读并同意以上协议</text>
      </view>
    </view>

    <view class="privacy-footer">
      <button class="btn-agree" bindtap="onAgree">同意并继续</button>
      <button class="btn-reject" bindtap="onReject">暂不使用</button>
    </view>
  </view>
</view>
