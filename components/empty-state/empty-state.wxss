.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  min-height: 400rpx;
}

.empty-icon-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
  color: var(--color-primary);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  text-align: center;
  line-height: 1.4;
}

.empty-description {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.empty-action {
  width: auto;
  min-width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  background-color: var(--color-primary);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  text-align: center;
  border: none;
  padding: 0 48rpx;
}

.empty-action::after {
  border: none;
}

.empty-action-hover {
  opacity: 0.8;
}

.font-large .empty-icon {
  font-size: 100rpx;
}

.font-large .empty-title {
  font-size: 36rpx;
}

.font-extra-large .empty-icon {
  font-size: 108rpx;
}

.font-extra-large .empty-title {
  font-size: 40rpx;
}
