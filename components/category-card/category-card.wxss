.category-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx;
  min-width: 120rpx;
}

.category-icon-hover {
  opacity: 0.8;
}

.category-icon-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.2s;
}

.category-icon-img.active {
  background-color: var(--color-primary);
}

.icon-image {
  width: 56rpx;
  height: 56rpx;
}

.icon-fallback {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.category-icon-name {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.3;
}

.category-card {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 2;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  background-color: var(--bg-color);
  border: 2rpx solid var(--border-color);
  transition: all 0.2s;
}

.category-card.active {
  border-color: var(--color-primary);
  box-shadow: 0 2rpx 16rpx rgba(255, 107, 157, 0.15);
}

.category-card-hover {
  opacity: 0.9;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

.card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  display: block;
  margin-bottom: 4rpx;
}

.card-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}
