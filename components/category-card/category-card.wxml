<!-- components/category-card/category-card.wxml - 分类卡片 -->
<!-- 图标模式（首页导航） -->
<view wx:if="{{mode === 'icon'}}" class="category-icon" bindtap="onTap" data-aria-label="{{category.name}}" hover-class="category-icon-hover">
  <view class="category-icon-img {{active ? 'active' : ''}}">
    <image class="icon-image" binderror="onImageError" data-aria-label="{{category.name}}图标" lazy-load="{{true}}" mode="aspectFit" src="{{category.icon || category.image}}" />
    <text wx:if="{{imageError}}" class="icon-fallback">{{category.name.slice(0, 1)}}</text>
  </view>
  <text class="category-icon-name font-large">{{category.name}}</text>
</view>

<!-- 卡片模式（分类页左侧Tab） -->
<view wx:elif="{{mode === 'card'}}" class="category-card {{active ? 'active' : ''}}" bindtap="onTap" data-aria-label="{{category.name}}" hover-class="category-card-hover">
  <image class="card-image" binderror="onImageError" data-aria-label="{{category.name}}图片" lazy-load="{{true}}" mode="aspectFill" src="{{category.image || category.icon}}" />
  <view class="card-overlay">
    <text class="card-name">{{category.name}}</text>
    <text wx:if="{{category.count}}" class="card-count">{{category.count}}件商品</text>
  </view>
</view>

<!-- 兜底：未知模式 -->
<view wx:else></view>