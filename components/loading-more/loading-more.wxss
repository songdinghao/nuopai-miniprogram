.loading-more {
  width: 100%;
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-spinner {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.spinner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  animation: loading-bounce 1.2s ease-in-out infinite;
}

@keyframes loading-bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.no-more-state {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  padding: 0 32rpx;
}

.no-more-line {
  flex: 1;
  height: 2rpx;
  background-color: var(--border-color);
}

.no-more-text {
  font-size: 24rpx;
  color: var(--text-disabled);
  white-space: nowrap;
}

.error-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  background-color: #fff5f5;
}

.error-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background-color: var(--color-red);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.error-text {
  font-size: 26rpx;
  color: var(--color-red);
}
