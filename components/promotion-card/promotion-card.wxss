.promotion-card {
  width: 460rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.promotion-card-hover {
  opacity: 0.9;
}

.card-content {
  display: flex;
  align-items: center;
  padding: 28rpx;
  min-height: 200rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.card-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.card-badge {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.card-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.card-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.promotion-banner {
  position: relative;
  width: 100%;
  height: 180rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.promotion-banner-hover {
  opacity: 0.95;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 32rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  line-height: 1.4;
}

.banner-right {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.banner-countdown {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.banner-arrow {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}
