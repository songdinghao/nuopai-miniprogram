# 微信支付配置（APIv3）
# 复制此文件为 .env 并填入真实信息

# 小程序AppID
WX_APPID=wx1234567890abcdef

# 微信支付商户号
WX_MCH_ID=1234567890

# APIv3密钥（在微信支付后台设置）
WX_API_V3_KEY=your-api-v3-key-here

# 证书序列号
WX_SERIAL_NO=YOUR_CERTIFICATE_SERIAL_NO

# 私钥文件路径（相对于项目根目录）
WX_PRIVATE_KEY_PATH=./config/apiclient_key.pem

# 证书文件路径（相对于项目根目录）
WX_CERTIFICATE_PATH=./config/apiclient_cert.pem

# 服务器端口
PORT=3000

# 环境（development | production）
NODE_ENV=development

# ========== 身份认证 ==========
# 有效 token 列表，格式：token1:userId1,token2:userId2
# 为每个客户端用户分配唯一 token 和 userId
VALID_TOKENS=your-secret-token-1:user_001,your-secret-token-2:user_002

# ========== 提现配置 ==========
# 最低提现金额（单位：分），默认 100（即 1 元）
MIN_WITHDRAW_AMOUNT=100

# ========== 数据库配置（TODO: 根据实际数据库类型配置） ==========
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=miniprogram_shop

# ========== Redis 配置（TODO: 生产环境启用） ==========
